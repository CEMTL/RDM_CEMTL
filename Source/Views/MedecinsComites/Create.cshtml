@model Solution.ViewModels.MedecinsComites.MedecinComiteFormViewModel
@{
    ViewBag.Title = "Nouvelle participation à un comité";
}

<div class="page-header-custom">
    <h2>Nouvelle participation à un comité</h2>
</div>

@using (Html.BeginForm("Create", "MedecinsComites", null, FormMethod.Post, null, null))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MedecinComiteId)
    @if (ViewBag.ReturnMedecinId != null)
    {
        <input type="hidden" name="returnMedecinId" value="@ViewBag.ReturnMedecinId" />
        <input type="hidden" name="returnTab" value="@ViewBag.ReturnTab" />
    }
    @await Html.PartialAsync("_Form", Model)

    <div class="dashboard-card text-right">
        @if (ViewBag.ReturnMedecinId != null)
        {
            <a href="@Url.Action("Index", "Medecins", new { openMedecin = ViewBag.ReturnMedecinId, tab = ViewBag.ReturnTab })" class="btn btn-default">Annuler</a>
        }
        else
        {
            @Html.ActionLink("Annuler", "Index", null, new { @class = "btn btn-default" })
        }
        <button type="submit" class="btn btn-success"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
