@model Solution.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Connexion RDM";
}
<!DOCTYPE html>
<html lang="fr-CA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion - Registre des médecins CEMTL</title>
    <style>
        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body {
            margin: 0;
            background: #f3f6f9;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #263442;
        }
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 28px 15px;
        }
        .login-card {
            width: 100%;
            max-width: 520px;
            background: #fff;
            border: 1px solid #dfe6ed;
            border-radius: 14px;
            box-shadow: 0 14px 38px rgba(31, 45, 61, .14);
            overflow: hidden;
        }
        .login-header {
            padding: 28px 32px;
            background: #17375e;
            color: #fff;
        }
        .login-header h1 {
            margin: 0 0 6px;
            font-size: 25px;
            font-weight: 600;
        }
        .login-header p { margin: 0; opacity: .92; }
        .login-body { padding: 30px 32px 28px; }
        .intro {
            margin: 0 0 22px;
            padding: 12px 14px;
            border-left: 4px solid #337ab7;
            background: #f4f8fc;
            line-height: 1.45;
        }
        .form-group { margin-bottom: 18px; }
        label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
        }
        .form-control {
            display: block;
            width: 100%;
            height: 44px;
            padding: 9px 12px;
            border: 1px solid #c9d4df;
            border-radius: 6px;
            background: #fff;
            font-size: 15px;
            outline: none;
        }
        .form-control:focus {
            border-color: #337ab7;
            box-shadow: 0 0 0 3px rgba(51, 122, 183, .12);
        }
        .password-wrapper {
            position: relative;
        }
        .password-wrapper .form-control {
            padding-right: 48px;
        }
        .password-toggle {
            position: absolute;
            top: 50%;
            right: 8px;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 5px;
            background: transparent;
            color: #5f6d7a;
            cursor: pointer;
            padding: 0;
        }
        .password-toggle:hover {
            background: #eef3f7;
            color: #17375e;
        }
        .password-toggle:focus {
            outline: 2px solid #337ab7;
            outline-offset: 1px;
        }
        .password-toggle svg {
            width: 21px;
            height: 21px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .btn-login {
            width: 100%;
            border: 0;
            border-radius: 6px;
            background: #337ab7;
            color: #fff;
            padding: 12px 16px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-login:hover { background: #286090; }
        .alert-danger {
            margin-bottom: 20px;
            padding: 12px 14px;
            border: 1px solid #ebccd1;
            border-radius: 6px;
            background: #f2dede;
            color: #a94442;
        }
        .validation {
            display: block;
            margin-top: 5px;
            color: #b42318;
            font-size: 13px;
        }
        .note {
            margin: 18px 0 0;
            color: #697887;
            font-size: 13px;
            line-height: 1.5;
        }
        .domain-example {
            color: #5f6d7a;
            font-size: 13px;
            margin-top: 5px;
        }
    </style>
</head>
<body>
<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <h1>Registre des médecins CEMTL</h1>
            <p>Connexion avec votre compte Windows</p>
        </div>

        <div class="login-body">
            <div class="intro">
                Saisissez votre <strong>compte Windows</strong> et votre <strong>mot de passe</strong> pour accéder à RDM.
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert-danger">@Model.ErrorMessage</div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="form-group">
                    <label asp-for="UserName"></label>
                    <input asp-for="UserName"
                           class="form-control"
                           autocomplete="username"
                           autofocus
                           placeholder="votre_compte (06CEMTL ou HMR)" />
                    <span asp-validation-for="UserName" class="validation"></span>
                  @*   <div class="domain-example">Exemple : 06CEMTL\t2-mera8300</div> *@
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <div class="password-wrapper">
                        <input asp-for="Password"
                               id="Password"
                               class="form-control"
                               type="password"
                               autocomplete="current-password" />
                        <button type="button"
                                id="togglePassword"
                                class="password-toggle"
                                aria-label="Afficher le mot de passe"
                                aria-pressed="false"
                                title="Afficher le mot de passe">
                            <svg id="eyeOpenIcon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="eyeClosedIcon" viewBox="0 0 24 24" aria-hidden="true" style="display:none">
                                <path d="M3 3l18 18"></path>
                                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                                <path d="M9.9 4.2A11.7 11.7 0 0 1 12 4c6.5 0 10 8 10 8a18 18 0 0 1-2.1 3.1"></path>
                                <path d="M6.6 6.6C3.7 8.3 2 12 2 12s3.5 8 10 8a9.7 9.7 0 0 0 4.1-.9"></path>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="validation"></span>
                </div>

                <button type="submit" class="btn-login">Se connecter</button>
            </form>

            <p class="note">
                    Votre identité est vérifiée par Active Directory sur les domaines <strong>06CEMTL</strong> et <strong>hmr.hmr.qc.ca</strong>.
                    Vous pouvez saisir le compte sans domaine. L’accès et les rôles RDM sont ensuite vérifiés dans la gestion des utilisateurs de l’application.
                </p>
        </div>
    </div>
</div>
<script>
    (function () {
        const passwordInput = document.getElementById('Password');
        const toggleButton = document.getElementById('togglePassword');
        const eyeOpenIcon = document.getElementById('eyeOpenIcon');
        const eyeClosedIcon = document.getElementById('eyeClosedIcon');

        if (!passwordInput || !toggleButton) return;

        toggleButton.addEventListener('click', function () {
            const showPassword = passwordInput.type === 'password';
            passwordInput.type = showPassword ? 'text' : 'password';

            toggleButton.setAttribute('aria-pressed', showPassword ? 'true' : 'false');
            toggleButton.setAttribute('aria-label', showPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
            toggleButton.setAttribute('title', showPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe');

            eyeOpenIcon.style.display = showPassword ? 'none' : '';
            eyeClosedIcon.style.display = showPassword ? '' : 'none';

            passwordInput.focus();
        });
    })();
</script>
</body>
</html>
