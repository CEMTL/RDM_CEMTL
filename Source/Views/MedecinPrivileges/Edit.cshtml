@model Solution.ViewModels.Privileges.MedecinPrivilegeFormViewModel

@{
    ViewBag.Title = "Modifier un privilège";
}

<div class="page-header-custom">
    <h2>Modifier un privilège</h2>
</div>

@using (Html.BeginForm("Edit", "MedecinPrivileges", new { id = Model.MedecinPrivilegeId }, FormMethod.Post, null, null))
{
    @Html.AntiForgeryToken()
    @if (ViewBag.ReturnMedecinId != null)
    {
        <input type="hidden" name="returnMedecinId" value="@ViewBag.ReturnMedecinId" />
        <input type="hidden" name="returnTab" value="@ViewBag.ReturnTab" />
    }
    @Html.HiddenFor(m => m.MedecinPrivilegeId)
    @Html.ValidationSummary(true, "Veuillez corriger les erreurs.", new { @class = "alert alert-danger" })

    @await Html.PartialAsync("_Form", Model)

    <div class="dashboard-card">
        <button type="submit" class="btn btn-success">Enregistrer</button>
        @if (ViewBag.ReturnMedecinId != null)
        {
            <a href="@Url.Action("Edit", "Medecins", new { id = ViewBag.ReturnMedecinId, tab = ViewBag.ReturnTab })" class="btn btn-default">Retour au médecin</a>
        }
        else
        {
            @Html.ActionLink("Retour", "Index", null, new { @class = "btn btn-default" })
        }
    </div>
}
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
