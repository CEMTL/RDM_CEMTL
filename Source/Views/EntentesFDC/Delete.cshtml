@model Solution.ViewModels.EntentesFDC.EntenteFDCDetailsViewModel

@{
    ViewBag.Title = "Supprimer une entente FDC";
}

<div class="page-header-custom">
    <div class="row">
        <div class="col-md-8">
            <h2>Supprimer une entente FDC</h2>
        </div>
        <div class="col-md-4 text-right" style="margin-top:25px;">
            @if (ViewBag.ReturnMedecinId != null)
            {
                <a href="@Url.Action("Index", "Medecins", new { openMedecin = ViewBag.ReturnMedecinId, tab = ViewBag.ReturnTab })" class="btn btn-default">Retour au médecin</a>
            }
            else
            {
                @Html.ActionLink("Retour à la liste", "Index", null, new { @class = "btn btn-default" })
            }
        </div>
    </div>
</div>

<div class="dashboard-card">
    <div class="alert alert-danger">
        <strong>Attention :</strong> cette action supprimera définitivement cette entente FDC.
    </div>

    <table class="table table-bordered table-striped">
        <tr><th style="width:220px;">ID</th><td>@Model.EntenteFDCId</td></tr>
        <tr><th>Médecin</th><td>@Model.MedecinLibelle</td></tr>
        <tr><th>Type entente</th><td>@Model.TypeEntenteFDC</td></tr>
        <tr><th>Date adhésion</th><td>@(Model.DateAdhesion.HasValue ? Model.DateAdhesion.Value.ToString("yyyy-MM-dd") : "")</td></tr>
        <tr><th>Date fin</th><td>@(Model.DateFin.HasValue ? Model.DateFin.Value.ToString("yyyy-MM-dd") : "")</td></tr>
        <tr><th>PEM visé</th><td>@Model.PEMVise</td></tr>
        <tr><th>Active</th><td>@(Model.EstActive ? "Oui" : "Non")</td></tr>
    </table>

    @using (Html.BeginForm("Delete", "EntentesFDC", null, FormMethod.Post, null, null))
    {
        @Html.AntiForgeryToken()
        @if (ViewBag.ReturnMedecinId != null)
        {
            <input type="hidden" name="returnMedecinId" value="@ViewBag.ReturnMedecinId" />
            <input type="hidden" name="returnTab" value="@ViewBag.ReturnTab" />
        }
        @Html.HiddenFor(m => m.EntenteFDCId)

        <div class="text-right">
            @if (ViewBag.ReturnMedecinId != null)
                {
                    <a href="@Url.Action("Index", "Medecins", new { openMedecin = ViewBag.ReturnMedecinId, tab = ViewBag.ReturnTab })" class="btn btn-default">Annuler</a>
                }
                else
                {
                    @Html.ActionLink("Annuler", "Index", null, new { @class = "btn btn-default" })
                }
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash"></i> Confirmer la suppression
            </button>
        </div>
    }
</div>