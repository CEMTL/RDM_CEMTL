
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-registre">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-registre">@TempData["Error"]</div>
}
@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger alert-registre">@TempData["Erreur"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-registre">@TempData["Warning"]</div>
}
