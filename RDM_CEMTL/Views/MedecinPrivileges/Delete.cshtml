@model Solution.ViewModels.Privileges.MedecinPrivilegeDetailsViewModel

@{
    ViewBag.Title = "Supprimer un privilège";
}

<div class="page-header-custom">
    <h2>Supprimer un privilège</h2>
</div>

<div class="alert alert-danger">
    <strong>Attention :</strong> cette suppression est définitive.
</div>

<div class="dashboard-card">
    <p><strong>@Model.MedecinNomComplet</strong></p>
    <p>@Model.CodePrivilege - @Model.PrivilegeLibelle</p>
    <p>Période : @(Model.DateDebut.HasValue ? Model.DateDebut.Value.ToString("yyyy-MM-dd") : "") à @(Model.DateFin.HasValue ? Model.DateFin.Value.ToString("yyyy-MM-dd") : "")</p>
</div>

@using (Html.BeginForm("Delete", "MedecinPrivileges", new { id = Model.MedecinPrivilegeId }, FormMethod.Post, null, null))
{
    @Html.AntiForgeryToken()
    @if (ViewBag.ReturnMedecinId != null)
    {
        <input type="hidden" name="returnMedecinId" value="@ViewBag.ReturnMedecinId" />
        <input type="hidden" name="returnTab" value="@ViewBag.ReturnTab" />
    }
    <div class="dashboard-card">
        <button type="submit" class="btn btn-danger">Supprimer</button>
        @if (ViewBag.ReturnMedecinId != null)
        {
            <a href="@Url.Action("Edit", "Medecins", new { id = ViewBag.ReturnMedecinId, tab = ViewBag.ReturnTab })" class="btn btn-default">Annuler</a>
        }
        else
        {
            @Html.ActionLink("Annuler", "Index", null, new { @class = "btn btn-default" })
        }
    </div>
}
