@model IEnumerable<Solution.ViewModels.Departements.DepartementListViewModel>
@{
    ViewBag.Title = "Départements";
    var canManage = User.IsInRole("Admin") || User.IsInRole("SuperUtilisateur");
}

@await Html.PartialAsync("~/Views/Shared/_Alerts.cshtml")

<div class="page-header-custom"><h2>Départements et services</h2></div>

<div class="dashboard-card filters-bar">
    @using (Html.BeginForm("Index", "Departements", null, FormMethod.Get, null, new { id = "formRechercheDepartements" }))
    {
        <div class="row">
            <div class="col-md-8">
                <input type="text" name="search" value="@Context.Request.Query["search"].ToString()" class="form-control" placeholder="Nom, code ou service" />
            </div>
            <div class="col-md-4 text-right">
                <button type="submit" class="btn btn-default"><i class="fa-solid fa-magnifying-glass"></i> Rechercher</button>
                @if (canManage)
                {
                    @Html.ActionLink("Nouveau département", "Create", null, new { @class = "btn btn-primary" })
                }
            </div>
        </div>
    }
</div>

<div class="dashboard-card">
    <table id="tableDepartements" class="table table-bordered table-striped table-hover registre-table">
        <thead><tr><th>Département</th><th>Code</th><th>Chef de département</th><th>Services</th><th>Actif</th><th class="nowrap" style="width:140px;">Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NomDepartement</td>
                <td>@item.CodeDepartement</td>
                <td>@(item.ChefDepartement ?? "—")</td>
                <td><a href="@Url.Action("Index", "Services", new { departementId = item.DepartementId })">@item.NombreServices</a></td>
                <td>@(item.EstActif ? "Oui" : "Non")</td>
                <td class="table-actions nowrap">
                    <a href="@Url.Action("Details", new { id = item.DepartementId })" class="btn btn-info btn-sm btn-icon-only" title="Détails"><i class="fa-solid fa-circle-info"></i></a>
                    @if (canManage)
                    {
                        <a href="@Url.Action("Edit", new { id = item.DepartementId })" class="btn btn-warning btn-sm btn-icon-only" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></a>
                        <a href="@Url.Action("Delete", new { id = item.DepartementId })" class="btn btn-danger btn-sm btn-icon-only" title="Supprimer"><i class="fa-solid fa-trash"></i></a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
$(function () {
    $("#tableDepartements").DataTable({
        pageLength: 25, ordering: true, searching: true, autoWidth: false, order: [[0, "asc"]],
        columnDefs: [{ orderable: false, searchable: false, targets: 5 }],
        language: { search: "Rechercher :", lengthMenu: "Afficher _MENU_ éléments", info: "Affichage de _START_ à _END_ sur _TOTAL_ éléments", infoEmpty: "Aucun élément", zeroRecords: "Aucun département trouvé", emptyTable: "Aucun département", paginate: { previous: "Précédent", next: "Suivant" } }
    });
});
</script>
}
