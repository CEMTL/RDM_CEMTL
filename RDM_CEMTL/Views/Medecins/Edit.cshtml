@model Solution.ViewModels.Medecins.MedecinEditViewModel

@{
    ViewBag.Title = Model.MedecinId == 0 ? "Créer un médecin" : "Modifier un médecin";
    Func<string, bool> aErreur = prefix => ViewData.ModelState.Any(kvp =>
        (string.Equals(kvp.Key, prefix, StringComparison.OrdinalIgnoreCase) ||
         kvp.Key.StartsWith(prefix + "[", StringComparison.OrdinalIgnoreCase) ||
         kvp.Key.StartsWith(prefix + ".", StringComparison.OrdinalIgnoreCase)) &&
        kvp.Value.Errors.Any());

    var erreurGeneral = ViewData.ModelState.Any(kvp => string.IsNullOrEmpty(kvp.Key) && kvp.Value.Errors.Any());
    var erreurInformationsGenerales = aErreur("InformationsGenerales");
    var erreurGeneralChamps = ViewData.ModelState.Any(kvp =>
        !string.IsNullOrEmpty(kvp.Key) &&
        !kvp.Key.Contains("[") &&
        !kvp.Key.StartsWith("Adresses", StringComparison.OrdinalIgnoreCase) &&
        !kvp.Key.StartsWith("Telephones", StringComparison.OrdinalIgnoreCase) &&
        !kvp.Key.StartsWith("Courriels", StringComparison.OrdinalIgnoreCase) &&
        !kvp.Key.StartsWith("NominationsAdministratives", StringComparison.OrdinalIgnoreCase) &&
        kvp.Value.Errors.Any());
    var erreurAdresses = aErreur("Adresses");
    var erreurTelephones = aErreur("Telephones");
    var erreurCourriels = aErreur("Courriels");
    var erreurNominations = aErreur("NominationsAdministratives");
    var activeEditTab = (ViewBag.ActiveEditTab as string) ?? "tab-general";
}

<style>
    .medecin-form .required-star {
        color: #d9534f;
        font-weight: 700;
        margin-left: 3px;
        font-size: 1.05em;
    }

    .medecin-form .required-fields-note {
        margin-bottom: 12px;
        color: #666;
        font-size: 13px;
    }

    .medecin-form .input-validation-error {
        border: 2px solid #d9534f !important;
        background-color: #fff7f7 !important;
        box-shadow: 0 0 0 2px rgba(217, 83, 79, 0.08);
    }

    .medecin-form .validation-error-group > label,
    .medecin-form .validation-error-group .control-label {
        color: #a94442;
        font-weight: 700;
    }

    .medecin-form .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #a94442 !important;
        font-weight: 600;
    }

    .medecin-form .validation-summary-errors {
        border-left: 4px solid #d9534f;
    }

    .medecin-form .validation-summary-errors ul {
        margin-top: 8px;
        margin-bottom: 0;
    }

    .medecin-form .client-validation-summary.validation-summary-valid {
        display: none;
    }

    .medecin-form .panel-validation-error {
        border: 2px solid #d9534f !important;
        box-shadow: 0 0 0 2px rgba(217, 83, 79, 0.08);
    }

    .medecin-form .panel-validation-error > .panel-heading {
        color: #a94442;
        background: #fff2f2;
        border-color: #ebccd1;
    }

    .medecin-form .validation-cell-error {
        outline: 2px solid #d9534f;
        outline-offset: -2px;
        background: #fff7f7 !important;
    }

    .medecin-form tr.validation-row-error > td {
        background-color: #fff7f7 !important;
    }

    .medecin-form tr.validation-row-error > td:first-child {
        border-left: 3px solid #d9534f !important;
    }

    .medecin-form .group-validation-message.field-validation-error,
    .medecin-form .client-group-error {
        display: block;
        margin: 0 0 10px;
        padding: 8px 10px;
        border-left: 4px solid #d9534f;
        background: #fff7f7;
        color: #a94442;
        font-weight: 600;
    }

    .medecin-form .group-validation-message.field-validation-valid {
        display: none;
    }

    .medecin-form .client-panel-validation-error {
        border: 2px solid #d9534f !important;
        box-shadow: 0 0 0 2px rgba(217, 83, 79, 0.08);
    }

    .medecin-form tr.client-row-validation-error > td {
        background-color: #fff7f7 !important;
    }

    .medecin-form .client-cell-validation-error {
        outline: 2px solid #d9534f;
        outline-offset: -2px;
        background: #fff7f7 !important;
    }

    .medecin-form .form-panel-general-error {
        border-color: #d9534f !important;
    }

    .medecin-edit-tabs > li.tab-validation-error > a {
        color: #a94442 !important;
        font-weight: 700;
    }

    .medecin-edit-tabs > li.tab-validation-error > a:after {
        content: " !";
        color: #d9534f;
        font-weight: 900;
    }

    .medecin-edit-tabs > li > a { padding: 9px 10px; font-weight: 600; }
    .medecin-edit-tabs .badge { margin-left:4px; background:#e5e7eb; color:#475569; }
    .medecin-edit-tabs > li.active > a .badge { background:#f59e0b; color:#fff; }
    .medecin-tab-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin:0 0 12px; }
    .medecin-tab-toolbar .summary { color:#64748b; font-weight:600; }
    .medecin-tab-table th { white-space:nowrap; }
    .medecin-tab-table td { vertical-align:middle !important; }
    .medecin-tab-empty { padding:20px; text-align:center; color:#64748b; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:8px; margin-bottom:12px; }
    .nowrap { white-space:nowrap; }

    .medecin-form .validation-fields-box {
        border: 2px solid #d9534f;
        background: #fff7f7;
        color: #7d2522;
    }

    .medecin-form .validation-fields-box .validation-fields-title {
        font-size: 15px;
        margin-bottom: 8px;
    }

    .medecin-form .validation-fields-list {
        margin: 8px 0 0 20px;
        padding: 0;
    }

    .medecin-form .validation-fields-list li {
        margin: 5px 0;
    }

    .medecin-form .validation-fields-list a {
        color: #a94442;
        text-decoration: underline;
        cursor: pointer;
    }

    .medecin-form .server-field-validation-error {
        border: 2px solid #d9534f !important;
        background-color: #fff7f7 !important;
        box-shadow: 0 0 0 2px rgba(217, 83, 79, 0.08);
    }
</style>

<div class="page-header">
    <div class="row">
        <div class="col-md-8">
            <h2>
                <i class="fa fa-user-md"></i>
                @(Model.MedecinId == 0 ? "Créer un médecin" : "Modifier un médecin")
            </h2>
        </div>
        <div class="col-md-4 text-right" style="margin-top:25px;">
            @if (Model.MedecinId > 0)
            {
                <a href="@Url.Action("Index", "Cmdpsf", new { openMedecin = Model.MedecinId, tab = "coordonnees" })" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Retour au dossier
                </a>
            }
            else
            {
                <a href="@Url.Action("Index", "Cmdpsf")" class="btn btn-default">
                    <i class="fa fa-arrow-left"></i> Retour à la liste
                </a>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/_Alerts.cshtml")

@using (Html.BeginForm("Edit", "Medecins", null, FormMethod.Post, null, new { id = "formMedecinEdit", @class = "medecin-form", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MedecinId)
    <input type="hidden" name="activeTab" id="activeEditTab" value="@activeEditTab" />

    <div class="required-fields-note">
        <span class="required-star" aria-hidden="true">*</span> Champ obligatoire
    </div>

    var erreursModel = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
    var erreursDetaillees = Model.ErreursValidation ?? new List<Solution.ViewModels.Medecins.MedecinEditValidationIssueViewModel>();

    @* Présent même lors du premier affichage : jquery.validate peut ainsi y énumérer
       toutes les erreurs client au lieu de ne montrer que les messages isolés. *@
    <div class="validation-summary-valid alert alert-danger client-validation-summary" data-valmsg-summary="true">
        <ul><li style="display:none"></li></ul>
    </div>

    if (erreursModel.Any() || (!ViewData.ModelState.IsValid))
    {
        <div class="alert validation-fields-box" id="validationFieldsBox">
            <div class="validation-fields-title">
                <strong><i class="fa fa-exclamation-triangle"></i> Le formulaire contient des erreurs.</strong>
            </div>

            @if (erreursDetaillees.Any())
            {
                <div>
                    <strong>@erreursDetaillees.Count problème(s) détecté(s) :</strong>
                </div>
                <ul class="validation-fields-list">
                    @foreach (var erreur in erreursDetaillees)
                    {
                        <li data-validation-key="@erreur.Cle" data-validation-tab="@erreur.Onglet">
                            <a href="#@erreur.Onglet" class="js-validation-jump" data-validation-key="@erreur.Cle" data-validation-tab="@erreur.Onglet">
                                <strong>@erreur.Champ</strong>
                            </a>
                            <span> — @erreur.Message</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div>Les informations suivantes doivent être corrigées :</div>
                @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
            }
        </div>
    }

    <div class="panel panel-primary @(erreurGeneral ? "form-panel-general-error" : "")">
        <div class="panel-heading">
            <strong><i class="fa fa-id-card-o"></i> Fiche médecin</strong>
        </div>
        <div class="panel-body">

            <ul class="nav nav-tabs medecin-edit-tabs" role="tablist">
                <li class="active @(erreurGeneralChamps ? "tab-validation-error" : "")"><a href="#tab-general" data-toggle="tab">Général</a></li>
                <li class="@((erreurAdresses || erreurTelephones || erreurCourriels) ? "tab-validation-error" : "")"><a href="#tab-coordonnees" data-toggle="tab">Coordonnées</a></li>
                <li><a href="#tab-organisation" data-toggle="tab">Organisation</a></li>
                <li class="@(erreurNominations ? "tab-validation-error" : "")"><a href="#tab-nominations" data-toggle="tab">Nominations</a></li>
                @if (Model.MedecinId > 0)
                {
                    <li><a href="#tab-privileges" data-toggle="tab">Privilèges <span class="badge">@Model.Dossier.Privileges.Count</span></a></li>
                    <li><a href="#tab-cotisations" data-toggle="tab">Cotisations <span class="badge">@Model.Dossier.Cotisations.Count</span></a></li>
                    <li><a href="#tab-fittests" data-toggle="tab">Fit Tests <span class="badge">@Model.Dossier.FitTests.Count</span></a></li>
                    <li><a href="#tab-ententes" data-toggle="tab">Ententes FDC <span class="badge">@Model.Dossier.EntentesFDC.Count</span></a></li>
                    <li><a href="#tab-comites" data-toggle="tab">Comités <span class="badge">@Model.Dossier.Comites.Count</span></a></li>
                    <li><a href="#tab-documents" data-toggle="tab">Documents <span class="badge">@Model.Dossier.Documents.Count(x => x.EstActif)</span></a></li>
                    <li><a href="#tab-alertes" data-toggle="tab">Alertes <span class="badge" style="@(Model.Dossier.Alertes.Any() ? "background:#dc3545;color:#fff;" : "")">@Model.Dossier.Alertes.Count</span></a></li>
                }
                <li><a href="#tab-commentaires" data-toggle="tab">Commentaires</a></li>
            </ul>

            <div class="tab-content" style="padding-top:20px;">

                <div class="tab-pane active @(erreurInformationsGenerales ? "panel-validation-error" : "")" id="tab-general">
                    <div class="row">
                        <div class="col-md-3 form-group">
                            @Html.LabelFor(m => m.TitreId)
                            @Html.DropDownListFor(m => m.TitreId, Model.Titres, "-- Sélectionner --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TitreId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 form-group">
                            @Html.LabelFor(m => m.Permis) <span class="required-star" aria-hidden="true">*</span><span class="sr-only"> obligatoire</span>
                            @Html.TextBoxFor(m => m.Permis, new { @class = "form-control required-field", maxlength = "20", required = "required", aria_required = "true" })
                            @Html.ValidationMessageFor(m => m.Permis, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 form-group">
                            @Html.LabelFor(m => m.NAM)
                            @Html.TextBoxFor(m => m.NAM, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.NAM, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 form-group">
                            <label style="display:block;">&nbsp;</label>
                            <label class="checkbox-inline">
                                @Html.CheckBoxFor(m => m.EstActif) @Html.DisplayNameFor(m => m.EstActif)
                            </label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.Nom) <span class="required-star" aria-hidden="true">*</span><span class="sr-only"> obligatoire</span>
                            @Html.TextBoxFor(m => m.Nom, new { @class = "form-control required-field", maxlength = "150", required = "required", aria_required = "true" })
                            @Html.ValidationMessageFor(m => m.Nom, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.Prenom) <span class="required-star" aria-hidden="true">*</span><span class="sr-only"> obligatoire</span>
                            @Html.TextBoxFor(m => m.Prenom, new { @class = "form-control required-field", maxlength = "150", required = "required", aria_required = "true" })
                            @Html.ValidationMessageFor(m => m.Prenom, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.GenreId)
                            @Html.DropDownListFor(m => m.GenreId, Model.Genres, "-- Sélectionner --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.GenreId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.TypePermisId)
                            @Html.DropDownListFor(m => m.TypePermisId, Model.TypesPermis, "-- Sélectionner --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TypePermisId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.StatutMedecinId)
                            @Html.DropDownListFor(m => m.StatutMedecinId, Model.StatutsMedecin, "-- Sélectionner --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.StatutMedecinId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.CategoriePratiqueId)
                            @Html.DropDownListFor(m => m.CategoriePratiqueId, Model.CategoriesPratique, "-- Sélectionner --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CategoriePratiqueId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-2 form-group">
                            @Html.LabelFor(m => m.DateNaissance)
                            @Html.TextBoxFor(m => m.DateNaissance, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.DateNaissance, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 form-group">
                            @Html.LabelFor(m => m.DateEntreeFonction)
                            @Html.TextBoxFor(m => m.DateEntreeFonction, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.DateEntreeFonction, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 form-group">
                            @Html.LabelFor(m => m.DateDepart)
                            @Html.TextBoxFor(m => m.DateDepart, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.DateDepart, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="tab-pane" id="tab-coordonnees">
                    <div class="panel panel-default @(erreurAdresses ? "panel-validation-error" : "")" id="validationPanelAdresses">
                        <div class="panel-heading clearfix">
                            <strong>Adresses</strong>
                            <button type="button" class="btn btn-success btn-xs pull-right" id="btnAddAdresse">
                                <i class="fa fa-plus"></i> Ajouter
                            </button>
                        </div>
                        <div class="panel-body">
                            @Html.ValidationMessage("Adresses", "", new { @class = "group-validation-message" })
                            <div class="client-group-error" id="clientErrorAdresses" style="display:none;"></div>
                            <table class="table table-bordered table-striped" id="tableAdresses">
                                <thead>
                                    <tr>
                                        <th>Adresse</th>
                                        <th>Ville</th>
                                        <th>Province</th>
                                        <th>Code postal</th>
                                        <th>Principale</th>
                                        <th>Retirer</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Adresses.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                @Html.HiddenFor(m => m.Adresses[i].MedecinAdresseId)
                                                @Html.TextBoxFor(m => m.Adresses[i].AdresseLigne1, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Adresses[i].AdresseLigne1, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(m => m.Adresses[i].Ville, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Adresses[i].Ville, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(m => m.Adresses[i].Province, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Adresses[i].Province, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(m => m.Adresses[i].CodePostal, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Adresses[i].CodePostal, "", new { @class = "text-danger" })
                                            </td>
                                            <td class="text-center">@Html.CheckBoxFor(m => m.Adresses[i].EstPrincipale)</td>
                                            <td class="text-center">@Html.CheckBoxFor(m => m.Adresses[i].Supprimer, new { @class = "js-remove-flag" })</td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-danger btn-sm js-remove-row">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="panel panel-default @(erreurTelephones ? "panel-validation-error" : "")" id="validationPanelTelephones">
                        <div class="panel-heading clearfix">
                            <strong>Téléphones</strong>
                            <button type="button" class="btn btn-success btn-xs pull-right" id="btnAddTelephone">
                                <i class="fa fa-plus"></i> Ajouter
                            </button>
                        </div>
                        <div class="panel-body">
                            @Html.ValidationMessage("Telephones", "", new { @class = "group-validation-message" })
                            <div class="client-group-error" id="clientErrorTelephones" style="display:none;"></div>
                            <table class="table table-bordered table-striped" id="tableTelephones">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Numéro</th>
                                        <th>Rang</th>
                                        <th>Principal</th>
                                        <th>Retirer</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Telephones.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                @Html.HiddenFor(m => m.Telephones[i].MedecinTelephoneId)
                                                @Html.DropDownListFor(
                                                     m => m.Telephones[i].TypeTelephone,
                                                     new SelectList(Model.TypesTelephoneDisponibles, "Value", "Text", Model.Telephones[i].TypeTelephone),
                                                     "-- Sélectionner --",
                                                     new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Telephones[i].TypeTelephone, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(m => m.Telephones[i].NumeroTelephone, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Telephones[i].NumeroTelephone, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(m => m.Telephones[i].RangSource, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Telephones[i].RangSource, "", new { @class = "text-danger" })
                                            </td>
                                            <td class="text-center @(erreurTelephones && Model.Telephones[i].EstPrincipal ? "validation-cell-error" : "")">@Html.CheckBoxFor(m => m.Telephones[i].EstPrincipal)</td>
                                            <td class="text-center">@Html.CheckBoxFor(m => m.Telephones[i].Supprimer, new { @class = "js-remove-flag" })</td>
                                            <td class="text-center"><button type="button" class="btn btn-danger btn-sm js-remove-row"><i class="fa fa-times"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="panel panel-default @(erreurCourriels ? "panel-validation-error" : "")" id="validationPanelCourriels">
                        <div class="panel-heading clearfix">
                            <strong>Courriels</strong>
                            <button type="button" class="btn btn-success btn-xs pull-right" id="btnAddCourriel">
                                <i class="fa fa-plus"></i> Ajouter
                            </button>
                        </div>
                        <div class="panel-body">
                            @Html.ValidationMessage("Courriels", "", new { @class = "group-validation-message" })
                            <div class="client-group-error" id="clientErrorCourriels" style="display:none;"></div>
                            <table class="table table-bordered table-striped" id="tableCourriels">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Courriel</th>
                                        <th>Rang</th>
                                        <th>Principal</th>
                                        <th>Retirer</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Courriels.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                @Html.HiddenFor(m => m.Courriels[i].MedecinCourrielId)
                                                @Html.DropDownListFor(
                                                     m => m.Courriels[i].TypeCourriel,
                                                     new SelectList(Model.TypesCourrielDisponibles, "Value", "Text", Model.Courriels[i].TypeCourriel),
                                                     "-- Sélectionner --",
                                                     new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Courriels[i].TypeCourriel, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(m => m.Courriels[i].AdresseCourriel, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Courriels[i].AdresseCourriel, "", new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(m => m.Courriels[i].RangSource, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Courriels[i].RangSource, "", new { @class = "text-danger" })
                                            </td>
                                            <td class="text-center @(erreurCourriels && Model.Courriels[i].EstPrincipal ? "validation-cell-error" : "")">@Html.CheckBoxFor(m => m.Courriels[i].EstPrincipal)</td>
                                            <td class="text-center">@Html.CheckBoxFor(m => m.Courriels[i].Supprimer, new { @class = "js-remove-flag" })</td>
                                            <td class="text-center"><button type="button" class="btn btn-danger btn-sm js-remove-row"><i class="fa fa-times"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="tab-pane" id="tab-organisation">
                    @if (Model.MedecinId > 0)
                    {
                        @await Html.PartialAsync("_EditOrganisationComplementaire", Model.Dossier)
                    }
                </div>

                <div class="tab-pane" id="tab-nominations">
                    <div class="panel panel-default @(erreurNominations ? "panel-validation-error" : "")" id="validationPanelNominations">
                        <div class="panel-heading clearfix">
                            <strong>Nominations administratives</strong>
                            <button type="button" class="btn btn-success btn-xs pull-right" id="btnAddNomination">
                                <i class="fa fa-plus"></i> Ajouter
                            </button>
                        </div>
                        <div class="panel-body">
                            @Html.ValidationMessage("NominationsAdministratives", "", new { @class = "group-validation-message" })
                            <div class="client-group-error" id="clientErrorNominations" style="display:none;"></div>
                            <table class="table table-bordered table-striped" id="tableNominations">
                                <thead>
                                    <tr>
                                        <th>Nomination (référence)</th>
                                        <th>Type de nomination</th>
                                        <th>Description</th>
                                        <th>Date nomination</th>
                                        <th>Date fin</th>
                                        <th>Active</th>
                                        <th>Retirer</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.NominationsAdministratives.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                @Html.HiddenFor(m => m.NominationsAdministratives[i].NominationAdministrativeId)
                                                @Html.DropDownListFor(
                                                              m => m.NominationsAdministratives[i].NominationId,
                                                              new SelectList(
                                                                  Model.NominationsDisponibles,
                                                                  "Value",
                                                                  "Text",
                                                                  Model.NominationsAdministratives[i].NominationId),
                                                              "-- Sélectionner --",
                                                              new { @class = "form-control" })
                                                @Html.ValidationMessageFor(
                                                              m => m.NominationsAdministratives[i].NominationId,
                                                              "",
                                                              new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.DropDownListFor(
                                                              m => m.NominationsAdministratives[i].TypeNominationId,
                                                              new SelectList(
                                                                  Model.TypesNominationDisponibles,
                                                                  "Value",
                                                                  "Text",
                                                                  Model.NominationsAdministratives[i].TypeNominationId),
                                                              "-- Sélectionner --",
                                                              new { @class = "form-control" })
                                                @Html.ValidationMessageFor(
                                                              m => m.NominationsAdministratives[i].TypeNominationId,
                                                              "",
                                                              new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(
                                                              m => m.NominationsAdministratives[i].LibelleNomination,
                                                              new { @class = "form-control" })
                                                @Html.ValidationMessageFor(
                                                              m => m.NominationsAdministratives[i].LibelleNomination,
                                                              "",
                                                              new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(
                                                              m => m.NominationsAdministratives[i].DateNomination,
                                                              "{0:yyyy-MM-dd}",
                                                              new { @class = "form-control", type = "date" })
                                                @Html.ValidationMessageFor(
                                                              m => m.NominationsAdministratives[i].DateNomination,
                                                              "",
                                                              new { @class = "text-danger" })
                                            </td>
                                            <td>
                                                @Html.TextBoxFor(
                                                              m => m.NominationsAdministratives[i].DateFin,
                                                              "{0:yyyy-MM-dd}",
                                                              new { @class = "form-control", type = "date" })
                                                @Html.ValidationMessageFor(
                                                              m => m.NominationsAdministratives[i].DateFin,
                                                              "",
                                                              new { @class = "text-danger" })
                                            </td>
                                            <td class="text-center">
                                                @Html.CheckBoxFor(m => m.NominationsAdministratives[i].EstActive)
                                            </td>
                                            <td class="text-center">
                                                @Html.CheckBoxFor(
                                                              m => m.NominationsAdministratives[i].Supprimer,
                                                              new { @class = "js-remove-flag" })
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-danger btn-sm js-remove-row">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @if (Model.MedecinId > 0)
                {
                    @await Html.PartialAsync("_EditDossierMetierTabs", Model.Dossier)
                }

                <div class="tab-pane" id="tab-commentaires">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Commentaires)
                        @Html.TextAreaFor(m => m.Commentaires, 8, 20, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Commentaires, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-right" style="margin-bottom:30px;">
        <a href="@Url.Action("Index", "Cmdpsf")" class="btn btn-default">Annuler</a>
        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save"></i> Enregistrer
        </button>
    </div>
}

@section Scripts {
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        var adresseIndex = @Model.Adresses.Count;
        var telephoneIndex = @Model.Telephones.Count;
        var courrielIndex = @Model.Courriels.Count;
        var nominationIndex = @Model.NominationsAdministratives.Count;
        var serverValidationIssues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (Model.ErreursValidation ?? new List<Solution.ViewModels.Medecins.MedecinEditValidationIssueViewModel>())
                .Select(x => new { cle = x.Cle ?? "", onglet = x.Onglet ?? "tab-general" })));
        var requestedEditTab = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(activeEditTab));

        var telephoneOptions = '@Html.Raw(string.Join("", Model.TypesTelephoneDisponibles.Select(x => "<option value=\"" + x.Value + "\">" + System.Net.WebUtility.HtmlEncode(x.Text) + "</option>")))';
        var courrielOptions = '@Html.Raw(string.Join("", Model.TypesCourrielDisponibles.Where(x => !x.Text.EndsWith("(ancienne valeur)")).Select(x => "<option value=\"" + System.Net.WebUtility.HtmlEncode(x.Value) + "\">" + System.Net.WebUtility.HtmlEncode(x.Text) + "</option>")))';
        var nominationOptions = '@Html.Raw(string.Join("", Model.NominationsDisponibles.Select(x => "<option value=\"" + x.Value + "\">" + System.Net.WebUtility.HtmlEncode(x.Text) + "</option>")))';
        var typeNominationOptions = '@Html.Raw(string.Join("", Model.TypesNominationDisponibles.Select(x => "<option value=\"" + x.Value + "\">" + System.Net.WebUtility.HtmlEncode(x.Text) + "</option>")))';

        function reparserValidation() {
            var form = $("#formMedecinEdit");
            form.removeData("validator");
            form.removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse(form);
        }


        function effacerErreursGroupesClient() {
            $(".client-group-error").hide().text("");
            $("#validationPanelTelephones, #validationPanelCourriels")
                .removeClass("client-panel-validation-error");
            $("#tableTelephones tr, #tableCourriels tr")
                .removeClass("client-row-validation-error");
            $("#tableTelephones td, #tableCourriels td")
                .removeClass("client-cell-validation-error");
        }

        function lignesActives(tableSelector, valueSelector) {
            return $(tableSelector + " tbody tr:visible").filter(function () {
                var $row = $(this);
                var supprimer = $row.find("input[name$='.Supprimer']:checkbox").first().is(":checked");
                if (supprimer) return false;

                var $value = $row.find(valueSelector).first();
                if (!$value.length) return true;

                var value = ($value.val() || "").toString().trim();
                return value !== "" && value !== "0";
            });
        }

        function signalerErreurGroupe(panelSelector, tableSelector, errorSelector, message, principalSelector) {
            $(panelSelector).addClass("client-panel-validation-error");
            $(errorSelector).text(message).show();

            $(tableSelector + " tbody tr:visible").each(function () {
                var $row = $(this);
                var $principal = $row.find(principalSelector).first();
                if ($principal.length && $principal.is(":checked")) {
                    $row.addClass("client-row-validation-error");
                    $principal.closest("td").addClass("client-cell-validation-error");
                }
            });
        }

        function validerGroupesPrincipaux() {
            effacerErreursGroupesClient();
            var valide = true;

            var $telephones = lignesActives("#tableTelephones", "input[name$='.NumeroTelephone']");
            if ($telephones.find("input[name$='.EstPrincipal']:checkbox:checked").length > 1) {
                signalerErreurGroupe(
                    "#validationPanelTelephones", "#tableTelephones", "#clientErrorTelephones",
                    "Un seul téléphone principal est permis.", "input[name$='.EstPrincipal']:checkbox");
                valide = false;
            }

            var $courriels = lignesActives("#tableCourriels", "input[name$='.AdresseCourriel']");
            if ($courriels.find("input[name$='.EstPrincipal']:checkbox:checked").length > 1) {
                signalerErreurGroupe(
                    "#validationPanelCourriels", "#tableCourriels", "#clientErrorCourriels",
                    "Un seul courriel principal est permis.", "input[name$='.EstPrincipal']:checkbox");
                valide = false;
            }

            if (!valide) {
                var $firstPanel = $(".client-panel-validation-error").first();
                var $tabPane = $firstPanel.closest(".tab-pane");
                if ($tabPane.length) {
                    $('.nav-tabs a[href="#' + $tabPane.attr("id") + '"]').tab("show");
                    $('.nav-tabs a[href="#' + $tabPane.attr("id") + '"]').parent().addClass("tab-validation-error");
                }
                setTimeout(function () {
                    $("html, body").animate({ scrollTop: Math.max(0, $firstPanel.offset().top - 120) }, 250);
                }, 100);
            }

            return valide;
        }

        function panneauPourCleValidation(cle) {
            if (!cle) return $();
            if (cle.indexOf("InformationsGenerales") === 0) return $("#tab-general");
            if (cle.indexOf("Adresses") === 0) return $("#validationPanelAdresses");
            if (cle.indexOf("Telephones") === 0) return $("#validationPanelTelephones");
            if (cle.indexOf("Courriels") === 0) return $("#validationPanelCourriels");
            if (cle.indexOf("NominationsAdministratives") === 0) return $("#validationPanelNominations");
            return $();
        }

        function surlignerErreursServeur() {
            (serverValidationIssues || []).forEach(function (issue) {
                var cle = issue.cle || "";
                if (!cle) return;

                var elements = document.getElementsByName(cle);
                if (elements && elements.length) {
                    $(elements).addClass("server-field-validation-error input-validation-error");
                    $(elements).closest(".form-group").addClass("has-error validation-error-group");
                    $(elements).closest("tr").addClass("validation-row-error");
                    var $panel = $(elements).closest(".panel");
                    if ($panel.length) $panel.addClass("panel-validation-error");
                } else {
                    var $panelGroupe = panneauPourCleValidation(cle);
                    if ($panelGroupe.length) {
                        $panelGroupe.addClass("panel-validation-error");
                    }
                }

                if (issue.onglet) {
                    $('.medecin-edit-tabs a[href="#' + issue.onglet + '"]').parent().addClass("tab-validation-error");
                }
            });
        }

        function allerAErreurServeur(issue, defiler) {
            if (!issue) return false;

            if (issue.onglet) {
                $('.medecin-edit-tabs a[href="#' + issue.onglet + '"]').tab("show");
            }

            var $target = $();
            if (issue.cle) {
                var elements = document.getElementsByName(issue.cle);
                if (elements && elements.length) {
                    $target = $(elements).filter(":visible").first();
                    if (!$target.length) $target = $(elements).first();
                }

                if (!$target.length) {
                    $target = panneauPourCleValidation(issue.cle);
                }
            }

            if (!$target.length && issue.onglet) {
                $target = $("#" + issue.onglet);
            }

            if (defiler && $target.length) {
                setTimeout(function () {
                    $("html, body").animate({ scrollTop: Math.max(0, $target.offset().top - 120) }, 250);
                    if ($target.is(":input") && $target.is(":visible")) $target.trigger("focus");
                }, 120);
            }

            return true;
        }

        function mettreEnEvidenceErreurs() {
            var $form = $("#formMedecinEdit");

            $form.find(".form-group").removeClass("has-error validation-error-group");
            $form.find("[aria-invalid='true']").removeAttr("aria-invalid");

            $form.find(".input-validation-error").each(function () {
                $(this)
                    .attr("aria-invalid", "true")
                    .closest(".form-group")
                    .addClass("has-error validation-error-group");
            });

            $form.find(".field-validation-error").each(function () {
                var $message = $(this);
                $message.closest(".form-group").addClass("has-error validation-error-group");

                var $panel = $message.closest(".panel");
                if ($panel.length) {
                    $panel.addClass("panel-validation-error");
                }

                var $row = $message.closest("tr");
                if ($row.length) {
                    $row.addClass("validation-row-error");
                }
            });

            $form.find(".input-validation-error").each(function () {
                var $input = $(this);
                $input.closest("tr").addClass("validation-row-error");
                var $panel = $input.closest(".panel");
                if ($panel.length) {
                    $panel.addClass("panel-validation-error");
                }
            });

            $(".medecin-edit-tabs > li").removeClass("tab-validation-error");
            $form.find(".tab-pane").each(function () {
                var $pane = $(this);
                if ($pane.find(".input-validation-error, .field-validation-error, .panel-validation-error, .client-panel-validation-error").length) {
                    $('.medecin-edit-tabs a[href="#' + $pane.attr("id") + '"]').parent().addClass("tab-validation-error");
                }
            });
        }

        function ouvrirOngletErreur(defiler) {
            var $form = $("#formMedecinEdit");
            var $firstError = $form.find(".input-validation-error").first();

            if ($firstError.length === 0) {
                $firstError = $form.find(".field-validation-error").first();
            }

            if ($firstError.length > 0) {
                var $tabPane = $firstError.closest(".tab-pane");
                if ($tabPane.length > 0) {
                    $('.nav-tabs a[href="#' + $tabPane.attr("id") + '"]').tab("show");
                }

                if (defiler) {
                    setTimeout(function () {
                        var $focus = $firstError.is(":input") ? $firstError : $firstError.closest(".form-group").find(":input:visible").first();
                        var $target = $focus.length ? $focus : $firstError;

                        $("html, body").animate({
                            scrollTop: Math.max(0, $target.offset().top - 120)
                        }, 250);

                        if ($focus.length) {
                            $focus.trigger("focus");
                        }
                    }, 150);
                }
            }
        }

        $(function () {
            var $form = $("#formMedecinEdit");

            function memoriserOngletActif(href) {
                if (href && href.indexOf("#tab-") === 0) {
                    $("#activeEditTab").val(href.substring(1));
                }
            }

            $(".medecin-edit-tabs a[data-toggle='tab']").on("shown.bs.tab", function (e) {
                memoriserOngletActif($(e.target).attr("href"));
            });

            $('.nav-tabs a').on('click', function (e) {
                e.preventDefault();
                $(this).tab('show');
            });

            var $requestedTab = $('.medecin-edit-tabs a[href="#' + requestedEditTab + '"]');
            if ($requestedTab.length) {
                $requestedTab.tab("show");
            } else {
                $("#activeEditTab").val("tab-general");
            }

            surlignerErreursServeur();
            mettreEnEvidenceErreurs();
            surlignerErreursServeur();

            if (serverValidationIssues && serverValidationIssues.length) {
                allerAErreurServeur(serverValidationIssues[0], true);
            } else {
                ouvrirOngletErreur(true);
            }

            $(document).on("click", ".js-validation-jump", function (e) {
                e.preventDefault();
                allerAErreurServeur({
                    cle: $(this).data("validation-key") || "",
                    onglet: $(this).data("validation-tab") || "tab-general"
                }, true);
            });

            $form.on("invalid-form.validate", function () {
                setTimeout(function () {
                    mettreEnEvidenceErreurs();
                    ouvrirOngletErreur(true);
                }, 0);
            });

            $form.on("submit", function (e) {
                memoriserOngletActif($(".medecin-edit-tabs li.active > a").attr("href"));

                if (!validerGroupesPrincipaux()) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return false;
                }
            });

            $form.on("change", "input[name$='.EstPrincipal'], input[name$='.Supprimer'], input[name$='.NumeroTelephone'], input[name$='.AdresseCourriel']", function () {
                validerGroupesPrincipaux();
            });

            $form.on("keyup change blur", ".form-control", function () {
                setTimeout(mettreEnEvidenceErreurs, 0);
            });
        });

        $(document).on("click", ".js-remove-row", function () {
            var $row = $(this).closest("tr");
            var $flag = $row.find(".js-remove-flag");

            // Conserver aussi les nouvelles lignes dans le DOM évite les trous d'index
            // (ex. [0], [2]) que le model binder interprète comme une fin de collection.
            // Le serveur ignore toute validation d'une ligne marquée Supprimer.
            $flag.prop("checked", true);
            $row.hide();
            validerGroupesPrincipaux();
        });

        $("#btnAddTelephone").on("click", function () {
            var html = `
                <tr>
                    <td style="display:none;">
                        <input type="hidden" name="Telephones[${telephoneIndex}].MedecinTelephoneId" value="0" />
                    </td>
                    <td>
                        <select class="form-control" name="Telephones[${telephoneIndex}].TypeTelephone">
                            <option value="">-- Sélectionner --</option>
                            ${telephoneOptions}
                        </select>
                    </td>
                    <td>
                        <input class="form-control" name="Telephones[${telephoneIndex}].NumeroTelephone" type="text" />
                    </td>
                    <td>
                        <input class="form-control" name="Telephones[${telephoneIndex}].RangSource" type="text" />
                    </td>
                    <td class="text-center">
                        <input name="Telephones[${telephoneIndex}].EstPrincipal" type="checkbox" value="true" />
                        <input name="Telephones[${telephoneIndex}].EstPrincipal" type="hidden" value="false" />
                    </td>
                    <td class="text-center">
                        <input class="js-remove-flag" name="Telephones[${telephoneIndex}].Supprimer" type="checkbox" value="true" />
                        <input name="Telephones[${telephoneIndex}].Supprimer" type="hidden" value="false" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm js-remove-row">
                            <i class="fa fa-times"></i>
                        </button>
                    </td>
                </tr>`;

            $("#tableTelephones tbody").append(html);
            telephoneIndex++;
            reparserValidation();
        });

        $("#btnAddCourriel").on("click", function () {
            var html = `
                <tr>
                    <td style="display:none;">
                        <input type="hidden" name="Courriels[${courrielIndex}].MedecinCourrielId" value="0" />
                    </td>
                    <td>
                        <select class="form-control" name="Courriels[${courrielIndex}].TypeCourriel">
                            <option value="">-- Sélectionner --</option>
                            ${courrielOptions}
                        </select>
                    </td>
                    <td>
                        <input class="form-control" name="Courriels[${courrielIndex}].AdresseCourriel" type="text" />
                    </td>
                    <td>
                        <input class="form-control" name="Courriels[${courrielIndex}].RangSource" type="text" />
                    </td>
                    <td class="text-center">
                        <input name="Courriels[${courrielIndex}].EstPrincipal" type="checkbox" value="true" />
                        <input name="Courriels[${courrielIndex}].EstPrincipal" type="hidden" value="false" />
                    </td>
                    <td class="text-center">
                        <input class="js-remove-flag" name="Courriels[${courrielIndex}].Supprimer" type="checkbox" value="true" />
                        <input name="Courriels[${courrielIndex}].Supprimer" type="hidden" value="false" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm js-remove-row">
                            <i class="fa fa-times"></i>
                        </button>
                    </td>
                </tr>`;

            $("#tableCourriels tbody").append(html);
            courrielIndex++;
            reparserValidation();
        });

        $("#btnAddAdresse").on("click", function () {
            var html = `
                <tr>
                    <td style="display:none;">
                        <input type="hidden" name="Adresses[${adresseIndex}].MedecinAdresseId" value="0" />
                    </td>
                    <td><input class="form-control" name="Adresses[${adresseIndex}].AdresseLigne1" type="text" /></td>
                    <td><input class="form-control" name="Adresses[${adresseIndex}].Ville" type="text" /></td>
                    <td><input class="form-control" name="Adresses[${adresseIndex}].Province" type="text" /></td>
                    <td><input class="form-control" name="Adresses[${adresseIndex}].CodePostal" type="text" /></td>
                    <td class="text-center">
                        <input name="Adresses[${adresseIndex}].EstPrincipale" type="checkbox" value="true" />
                        <input name="Adresses[${adresseIndex}].EstPrincipale" type="hidden" value="false" />
                    </td>
                    <td class="text-center">
                        <input class="js-remove-flag" name="Adresses[${adresseIndex}].Supprimer" type="checkbox" value="true" />
                        <input name="Adresses[${adresseIndex}].Supprimer" type="hidden" value="false" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm js-remove-row">
                            <i class="fa fa-times"></i>
                        </button>
                    </td>
                </tr>`;

            $("#tableAdresses tbody").append(html);
            adresseIndex++;
            reparserValidation();
        });

        $("#btnAddNomination").on("click", function () {
            var html = `
                <tr>
                    <td style="display:none;">
                        <input type="hidden" name="NominationsAdministratives[${nominationIndex}].NominationAdministrativeId" value="0" />
                    </td>
                    <td>
                        <select class="form-control" name="NominationsAdministratives[${nominationIndex}].NominationId">
                            <option value="">-- Sélectionner --</option>
                            ${nominationOptions}
                        </select>
                    </td>
                    <td>
                        <select class="form-control" name="NominationsAdministratives[${nominationIndex}].TypeNominationId">
                            <option value="">-- Sélectionner --</option>
                            ${typeNominationOptions}
                        </select>
                    </td>
                    <td>
                        <input class="form-control" name="NominationsAdministratives[${nominationIndex}].LibelleNomination" type="text" />
                    </td>
                    <td>
                        <input class="form-control" name="NominationsAdministratives[${nominationIndex}].DateNomination" type="date" />
                    </td>
                    <td>
                        <input class="form-control" name="NominationsAdministratives[${nominationIndex}].DateFin" type="date" />
                    </td>
