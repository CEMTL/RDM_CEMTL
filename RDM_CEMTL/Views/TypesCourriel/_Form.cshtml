@model Solution.ViewModels.TypesCourriel.TypeCourrielFormViewModel

@Html.ValidationSummary(false, "Veuillez corriger les erreurs indiquées.", new { @class = "alert alert-danger" })

<div class="form-horizontal">
    <div class="form-group">
        @Html.LabelFor(m => m.Libelle, new { @class = "col-md-2 control-label" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.Libelle, new { @class = "form-control", maxlength = "50", autocomplete = "off" })
            @Html.ValidationMessageFor(m => m.Libelle, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.EstActif, new { @class = "col-md-2 control-label" })
        <div class="col-md-6" style="padding-top:7px;">
            <label class="checkbox-inline">@Html.CheckBoxFor(m => m.EstActif) Disponible dans les formulaires</label>
        </div>
    </div>
</div>
