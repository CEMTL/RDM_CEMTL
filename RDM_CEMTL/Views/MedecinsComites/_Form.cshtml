@model Solution.ViewModels.MedecinsComites.MedecinComiteFormViewModel

<div class="dashboard-card">
    <div class="form-group">
        @Html.LabelFor(m => m.MedecinId)
        @if (ViewBag.ReturnMedecinId != null)
        {
            var medecinSelectionne = Model.MedecinIdOptions?.FirstOrDefault(x => x.Value == Model.MedecinId.ToString());
            @Html.HiddenFor(m => m.MedecinId)
            <input type="text" class="form-control" value="@(medecinSelectionne?.Text ?? Model.MedecinId.ToString())" readonly="readonly" />
        }
        else
        {
            @Html.DropDownListFor(m => m.MedecinId, Model.MedecinIdOptions, "-- Sélectionner --", new { @class = "form-control" })
        }
        @Html.ValidationMessageFor(m => m.MedecinId, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.ComiteId)
        @Html.DropDownListFor(m => m.ComiteId, Model.ComiteIdOptions, "-- Sélectionner --", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.ComiteId, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.RoleMembre)
        @Html.TextBoxFor(m => m.RoleMembre, new { @class = "form-control", maxlength = "100" })
        @Html.ValidationMessageFor(m => m.RoleMembre, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.DateDebut)
        @Html.TextBoxFor(m => m.DateDebut, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.DateDebut, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.DateFin)
        @Html.TextBoxFor(m => m.DateFin, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.DateFin, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Commentaire)
        @Html.TextAreaFor(m => m.Commentaire, 4, 80, new { @class = "form-control", maxlength = "500" })
        @Html.ValidationMessageFor(m => m.Commentaire, "", new { @class = "text-danger" })
    </div>
</div>
