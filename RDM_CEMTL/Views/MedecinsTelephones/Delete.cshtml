@model Solution.ViewModels.MedecinsTelephones.MedecinTelephoneDetailsViewModel
@{
    ViewBag.Title = "Supprimer MedecinTelephone";
}

<div class="page-header-custom">
    <h2>Supprimer MedecinTelephone</h2>
</div>

<div class="dashboard-card">
    <p>Confirmez-vous la suppression de cet enregistrement ?</p>
    <dl class="dl-horizontal">
        <dt>Médecin</dt>
        <dd>@Model.MedecinLibelle</dd>
        <dt>Type</dt>
        <dd>@Model.TypeTelephone</dd>
        <dt>Numéro</dt>
        <dd>@Model.NumeroTelephone</dd>
        <dt>Rang</dt>
        <dd>@Model.RangSource</dd>
        <dt>Principal</dt>
        <dd>@(Model.EstPrincipal ? "Oui" : "Non")</dd>
    </dl>

    @using (Html.BeginForm(null, null, new { medecinId = Model.MedecinId }, FormMethod.Post, null, null))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger btn-icon-only" title="Supprimer"><i class="fa-solid fa-trash"></i></button>
        <a href="@Url.Action("Index")" class="btn btn-default btn-icon-only" title="Annuler"><i class="fa-solid fa-xmark"></i></a>
    }
</div>
<div class="dashboard-card" style="margin-bottom:12px">
    @if (Model.MedecinId > 0) {
        <a class="btn btn-default" asp-controller="Cmdpsf" asp-action="Details" asp-route-id="@Model.MedecinId"><i class="fa-solid fa-arrow-left"></i> Retour à la fiche CMDPSF</a>
    }
</div>
