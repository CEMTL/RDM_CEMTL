@model Solution.ViewModels.MedecinAffectationsCliniques.MedecinAffectationCliniqueFormViewModel
@{
    ViewBag.Title = "Nouvelle affectation clinique";
}
<div class="page-header-custom">
    <h2>Nouvelle affectation clinique</h2>
    <p class="text-muted">Appartenance clinique du médecin à un département et un service.</p>
</div>
<div class="dashboard-card">
    @using (Html.BeginForm("Create", "MedecinAffectationsCliniques", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        @await Html.PartialAsync("_Form", Model)
        <hr />
        <div class="text-right">
            @if (Model.ReturnMedecinId.HasValue)
            {
                <a class="btn btn-default" href="@Url.Action("Index", "Cmdpsf", new { openMedecin = Model.ReturnMedecinId, tab = Model.ReturnTab ?? "organisation" })">Annuler</a>
            }
            else
            {
                <a class="btn btn-default" href="@Url.Action("Index")">Annuler</a>
            }
            <button type="submit" class="btn btn-success"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
        </div>
    }
</div>
