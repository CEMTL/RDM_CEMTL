@model Solution.ViewModels.CotisationsAnnuelles.CotisationRecuViewModel
@{
    Layout = null;
    var description = string.IsNullOrWhiteSpace(Model.Description)
        ? Model.CodeCotisation
        : Model.Description;
}
<!DOCTYPE html>
<html lang="fr-CA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reçu @Model.NumeroRecu</title>
    <style>
        :root {
            color-scheme: light;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #1f2937;
            background: #eef2f5;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 28px;
            background: #eef2f5;
        }

        .toolbar {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .button {
            display: inline-block;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 10px 18px;
            color: #1f2937;
            background: #fff;
            font: inherit;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
        }

        .button-primary {
            color: #fff;
            border-color: #176b52;
            background: #176b52;
        }

        .receipt {
            width: 100%;
            max-width: 820px;
            min-height: 880px;
            margin: 0 auto;
            padding: 48px 56px;
            border: 1px solid #d7dee5;
            border-top: 8px solid #176b52;
            border-radius: 4px;
            background: #fff;
            box-shadow: 0 12px 36px rgba(31, 41, 55, .12);
        }

        .header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 32px;
            padding-bottom: 26px;
            border-bottom: 1px solid #d7dee5;
        }

        .identity {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .mark {
            display: grid;
            width: 60px;
            height: 60px;
            place-items: center;
            border-radius: 50%;
            color: #fff;
            background: #176b52;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: .04em;
        }

        .organization { max-width: 470px; }
        .organization strong { display: block; font-size: 17px; line-height: 1.35; }
        .organization span { display: block; margin-top: 4px; color: #52616f; font-size: 13px; line-height: 1.4; }

        .receipt-id { text-align: right; white-space: nowrap; }
        .receipt-id .label { color: #64748b; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
        .receipt-id .number { margin-top: 5px; color: #176b52; font-size: 18px; font-weight: 800; }

        h1 {
            margin: 38px 0 8px;
            color: #172033;
            font-size: 32px;
            font-weight: 750;
            letter-spacing: -.02em;
        }

        .lead { margin: 0 0 30px; color: #64748b; }

        .recipient {
            margin-bottom: 30px;
            padding: 18px 20px;
            border-left: 4px solid #80b9a8;
            background: #f3f8f6;
        }

        .recipient .label, .section-label {
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .recipient .name { margin-top: 6px; font-size: 20px; font-weight: 750; }
        .recipient .permit { margin-top: 3px; color: #52616f; font-size: 13px; }

        .details {
            width: 100%;
            margin: 10px 0 30px;
            border-collapse: collapse;
        }

        .details th, .details td {
            padding: 12px 0;
            border-bottom: 1px solid #e5e9ee;
            text-align: left;
            vertical-align: top;
        }

        .details th { width: 42%; color: #52616f; font-size: 13px; font-weight: 600; }
        .details td { font-weight: 650; }

        .amount-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 34px 0;
            padding: 22px 24px;
            border: 1px solid #acd1c5;
            border-radius: 8px;
            background: #edf7f4;
        }

        .amount-box .caption { color: #315f51; font-size: 15px; font-weight: 700; }
        .amount-box .amount { color: #12553f; font-size: 30px; font-weight: 800; }

        .balance {
            margin-top: -18px;
            color: #52616f;
            font-size: 13px;
            text-align: right;
        }

        .footer {
            margin-top: 50px;
            padding-top: 18px;
            border-top: 1px solid #d7dee5;
            color: #64748b;
            font-size: 11px;
            line-height: 1.55;
        }

        .footer-meta {
            display: flex;
            justify-content: space-between;
            gap: 18px;
            margin-top: 10px;
        }

        @@page { size: Letter portrait; margin: 12mm; }

        @@media print {
            :root, body { background: #fff; }
            body { padding: 0; }
            .toolbar { display: none !important; }
            .receipt {
                max-width: none;
                min-height: 0;
                padding: 24px 28px;
                border-right: 0;
                border-bottom: 0;
                border-left: 0;
                box-shadow: none;
            }
        }

        @@media (max-width: 640px) {
            body { padding: 12px; }
            .receipt { min-height: 0; padding: 28px 24px; }
            .header, .footer-meta { flex-direction: column; }
            .receipt-id { text-align: left; }
            .amount-box { align-items: flex-start; flex-direction: column; gap: 8px; }
        }
    </style>
</head>
<body>
    <div class="toolbar" aria-label="Actions du reçu">
        <button type="button" class="button button-primary" onclick="window.print()">Imprimer le reçu</button>
        <button type="button" class="button" onclick="window.close()">Fermer</button>
    </div>

    <main class="receipt">
        <header class="header">
            <div class="identity">
                <div class="mark" aria-hidden="true">CEMTL</div>
                <div class="organization">
                    <strong>Conseil des médecins, dentistes, pharmaciens et sages-femmes</strong>
                    <span>Centre intégré universitaire de santé et de services sociaux de l’Est-de-l’Île-de-Montréal</span>
                </div>
            </div>
            <div class="receipt-id">
                <div class="label">Numéro de reçu</div>
                <div class="number">@Model.NumeroRecu</div>
            </div>
        </header>

        <h1>Reçu de paiement</h1>
        <p class="lead">Cotisation annuelle — exercice @Model.AnneeExercice</p>

        <section class="recipient" aria-label="Payeur">
            <div class="label">Reçu de</div>
            <div class="name">@Model.MedecinNomComplet</div>
            @if (!string.IsNullOrWhiteSpace(Model.NumeroPermis))
            {
                <div class="permit">Numéro de permis : @Model.NumeroPermis</div>
            }
        </section>

        <div class="section-label">Renseignements sur le paiement</div>
        <table class="details">
            <tbody>
                <tr>
                    <th>Date du paiement</th>
                    <td>@Model.DatePaiement.ToString("d MMMM yyyy")</td>
                </tr>
                <tr>
                    <th>Cotisation</th>
                    <td>@(string.IsNullOrWhiteSpace(description) ? "Cotisation annuelle" : description)</td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(Model.CodeCotisation) && !string.Equals(description, Model.CodeCotisation, StringComparison.Ordinal))
                {
                    <tr>
                        <th>Code</th>
                        <td>@Model.CodeCotisation</td>
                    </tr>
                }
                <tr>
                    <th>Mode de paiement</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.TypePaiement) ? "Non précisé" : Model.TypePaiement)</td>
                </tr>
                @if (Model.DateDepot.HasValue)
                {
                    <tr>
                        <th>Date du dépôt</th>
                        <td>@Model.DateDepot.Value.ToString("d MMMM yyyy")</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(Model.NumeroDepot))
                {
                    <tr>
                        <th>Numéro de dépôt</th>
                        <td>@Model.NumeroDepot</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ReferenceRecuImposition))
                {
                    <tr>
                        <th>Référence du reçu d’imposition</th>
                        <td>@Model.ReferenceRecuImposition</td>
                    </tr>
                }
            </tbody>
        </table>

        <section class="amount-box" aria-label="Montant reçu">
            <div class="caption">Montant reçu</div>
            <div class="amount">@Model.MontantPaye.ToString("C2")</div>
        </section>

        @if (Model.Solde > 0m)
        {
            <div class="balance">Solde restant : <strong>@Model.Solde.ToString("C2")</strong></div>
        }

        <footer class="footer">
            <div>Ce document confirme le paiement enregistré dans le registre RDM. Il ne constitue un reçu fiscal que lorsqu’une référence de reçu d’imposition y figure.</div>
            <div class="footer-meta">
                <span>Imprimé le @Model.DateImpression.ToString("d MMMM yyyy 'à' HH 'h' mm")</span>
                @if (!string.IsNullOrWhiteSpace(Model.ImprimePar))
                {
                    <span>Imprimé par @Model.ImprimePar</span>
                }
            </div>
        </footer>
    </main>
</body>
</html>
