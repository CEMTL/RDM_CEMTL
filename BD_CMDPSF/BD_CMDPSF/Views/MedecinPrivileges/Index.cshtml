@model IEnumerable<Solution.ViewModels.Privileges.MedecinPrivilegeGroupViewModel>
@{
    int cmdpsfReturnId;
    bool aFicheCmdpsf = int.TryParse(Context.Request.Query["medecinId"].ToString(), out cmdpsfReturnId) && cmdpsfReturnId > 0;
}
@if (aFicheCmdpsf) {
    <div class="dashboard-card"><a class="btn btn-default" asp-controller="Cmdpsf" asp-action="Details" asp-route-id="@cmdpsfReturnId"><i class="fa-solid fa-arrow-left"></i> Retour à la fiche CMDPSF</a></div>
}


@{
    ViewBag.Title = "Privilèges des médecins";
    var canManage = ViewBag.CanManage != null && (bool)ViewBag.CanManage;
}

@section Styles{
    <style>
        .privileges-summary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .privileges-count {
            display: inline-block;
            min-width: 32px;
            padding: 4px 9px;
            border-radius: 12px;
            background: #f1f5f9;
            color: #334155;
            font-weight: 700;
            text-align: center;
        }

        .privileges-count.active-count {
            background: #ecfdf5;
            color: #047857;
        }

        .btn-privileges-popup {
            min-width: 170px;
        }

        .privileges-modal .modal-dialog {
            width: 94%;
            max-width: 1320px;
        }

        .privileges-modal .modal-header {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            border-radius: 6px 6px 0 0;
        }

        .privileges-modal .modal-title {
            font-weight: 700;
            color: #334155;
        }

        .privileges-modal .modal-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .privileges-modal .modal-summary {
            color: #64748b;
            font-weight: 600;
        }

        .privileges-modal .table-responsive {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
        }

        .privileges-modal table {
            margin-bottom: 0;
        }

        .privileges-modal th {
            white-space: nowrap;
            background: #f8fafc;
        }

        .privileges-modal .etat-actif {
            color: #047857;
            font-weight: 700;
        }

        .privileges-modal .etat-inactif {
            color: #64748b;
        }

        .privileges-modal .table-actions {
            min-width: 135px;
        }

        @@media (max-width: 767px) {
            .privileges-modal .modal-dialog {
                width: auto;
                margin: 10px;
            }

            .btn-privileges-popup {
                min-width: 0;
            }
        }
    </style>
}

<div class="page-header-custom">
    <div class="row">
        <div class="col-md-8">
            <h2>Privilèges des médecins</h2>
            <div class="page-subtitle">Une ligne par médecin. Utilisez le bouton Privilèges pour consulter et gérer tous ses privilèges.</div>
        </div>
        <div class="col-md-4 text-right" style="margin-top:25px;">
            @if (canManage)
            {
                <a href="@Url.Action("Create")" class="btn btn-success">
                    <i class="fa-solid fa-plus"></i> Nouveau privilège
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@using (Html.BeginForm("Index", "MedecinPrivileges", null, FormMethod.Get, null, new { @class = "dashboard-card", id = "formFiltresPrivileges" }))
{
    <div class="row">
        <div class="col-md-7">
            <label>Recherche</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Médecin, permis, privilège..." />
        </div>
        <div class="col-md-3">
            <label>État</label>
            <select name="etat" class="form-control">
                <option value="">-- Tous --</option>
                @foreach (var etatOption in new[] { "Actif", "Suspendu", "Expiré", "En attente", "Refusé", "Non renouvelé" })
                {
                    if (ViewBag.Etat == etatOption)
                    {
                        <option value="@etatOption" selected="selected">@etatOption</option>
                    }
                    else
                    {
                        <option value="@etatOption">@etatOption</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label>&nbsp;</label>
            <div class="checkbox">
                <label>
                    @if (ViewBag.ActifsSeulement != null && (bool)ViewBag.ActifsSeulement)
                    {
                        <input type="checkbox" name="actifsSeulement" value="true" checked="checked" />
                    }
                    else
                    {
                        <input type="checkbox" name="actifsSeulement" value="true" />
                    }
                    Actifs seulement
                </label>
            </div>
        </div>
    </div>

    <div style="margin-top:15px;">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter"></i> Filtrer
        </button>
        <a href="@Url.Action("Index")" class="btn btn-default">
            <i class="fa-solid fa-rotate-left"></i> Réinitialiser
        </a>
    </div>
}

<div class="dashboard-card">
    <div class="table-responsive">
        <table id="tableMedecinPrivileges" class="table table-bordered table-striped table-hover registre-table">
            <thead>
                <tr>
                    <th>Médecin</th>
                    <th style="width:130px;">Total</th>
                    <th style="width:140px;">Actifs</th>
                    <th class="nowrap" style="width:210px;">Privilèges</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MedecinNomComplet</td>
                            <td>
                                <span class="privileges-count">@item.NombrePrivileges</span>
                            </td>
                            <td>
                                <span class="privileges-count active-count">@item.NombrePrivilegesActifs</span>
                            </td>
                            <td class="table-actions nowrap">
                                <button type="button"
                                        class="btn btn-info btn-sm btn-privileges-popup"
                                        data-toggle="modal"
                                        data-target="#modalPrivileges-@item.MedecinId"
                                        title="Afficher les privilèges">
                                    <i class="fa-solid fa-list-check"></i>
                                    Privilèges (@item.NombrePrivileges)
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model != null)
{
    foreach (var item in Model)
    {
        <div class="modal fade privileges-modal" id="modalPrivileges-@item.MedecinId" tabindex="-1" role="dialog" aria-labelledby="modalPrivilegesLabel-@item.MedecinId">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="modalPrivilegesLabel-@item.MedecinId">
                            <i class="fa-solid fa-user-doctor"></i> @item.MedecinNomComplet
                        </h4>
                    </div>
                    <div class="modal-body">
                        <div class="modal-toolbar">
                            <div class="modal-summary">
                                @item.NombrePrivileges privilège(s) au total · @item.NombrePrivilegesActifs actif(s)
                            </div>
                            @if (canManage)
                            {
                                <a href="@Url.Action("Create", new { medecinId = item.MedecinId })" class="btn btn-success btn-sm">
                                    <i class="fa-solid fa-plus"></i> Ajouter un privilège
                                </a>
                            }
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Privilège</th>
                                        <th>Installation</th>
                                        <th>Département</th>
                                        <th>Service</th>
                                        <th>Date début</th>
                                        <th>Date fin</th>
                                        <th>État</th>
                                        <th>Actif</th>
                                        <th class="nowrap">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var privilege in item.Privileges)
                                    {
                                        <tr>
                                            <td>@privilege.CodePrivilege</td>
                                            <td>@privilege.PrivilegeLibelle</td>
                                            <td>@privilege.InstallationLibelle</td>
                                            <td>@privilege.DepartementLibelle</td>
                                            <td>@privilege.ServiceLibelle</td>
                                            <td>@(privilege.DateDebut.HasValue ? privilege.DateDebut.Value.ToString("yyyy-MM-dd") : "")</td>
                                            <td>@(privilege.DateFin.HasValue ? privilege.DateFin.Value.ToString("yyyy-MM-dd") : "")</td>
                                            <td>@privilege.Etat</td>
                                            <td class="@(privilege.EstActif ? "etat-actif" : "etat-inactif")">
                                                @(privilege.EstActif ? "Oui" : "Non")
                                            </td>
                                            <td class="table-actions nowrap">
                                                <a href="@Url.Action("Details", new { id = privilege.MedecinPrivilegeId })" class="btn btn-info btn-sm btn-icon-only" title="Détails">
                                                    <i class="fa-solid fa-circle-info"></i>
                                                </a>
                                                @if (canManage)
                                                {
                                                    <a href="@Url.Action("Edit", new { id = privilege.MedecinPrivilegeId })" class="btn btn-warning btn-sm btn-icon-only" title="Modifier">
                                                        <i class="fa-solid fa-pen-to-square"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", new { id = privilege.MedecinPrivilegeId })" class="btn btn-danger btn-sm btn-icon-only" title="Supprimer">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">
                            <i class="fa-solid fa-xmark"></i> Fermer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts{
    <script>
        $(function () {
            $("#tableMedecinPrivileges").DataTable({
                pageLength: 10,
                lengthMenu: [[5, 10, 25, 50, 100], [5, 10, 25, 50, 100]],
                paging: true,
                ordering: true,
                info: true,
                searching: true,
                autoWidth: false,
                pagingType: "simple_numbers",
                order: [[0, "asc"]],
                columnDefs: [
                    { orderable: false, searchable: false, targets: 3 }
                ],
                language: {
                    processing: "Traitement en cours...",
                    search: "Rechercher :",
                    lengthMenu: "Afficher _MENU_ médecins",
                    info: "Affichage du médecin _START_ à _END_ sur _TOTAL_ médecins",
                    infoEmpty: "Aucun médecin à afficher",
                    infoFiltered: "(filtré de _MAX_ médecins au total)",
                    loadingRecords: "Chargement en cours...",
                    zeroRecords: "Aucun médecin à afficher",
                    emptyTable: "Aucune donnée disponible dans le tableau",
                    paginate: {
                        first: "Premier",
                        previous: "Précédent",
                        next: "Suivant",
                        last: "Dernier"
                    }
                }
            });
        });
    </script>
}
