@model IEnumerable<Solution.ViewModels.MedecinsAdresses.MedecinAdresseListViewModel>
@{
    var cmdpsfMedecinId = ViewBag.CmdpsfMedecinId as int?;
}
@if (cmdpsfMedecinId.HasValue) {
    <div class="dashboard-card">
        <a class="btn btn-default" asp-controller="Cmdpsf" asp-action="Details" asp-route-id="@cmdpsfMedecinId.Value"><i class="fa-solid fa-arrow-left"></i> Retour à la fiche CMDPSF</a>
    </div>
}

@{
    ViewBag.Title = "MedecinsAdresses";
}


@await Html.PartialAsync("~/Views/Shared/_Alerts.cshtml")

<div class="dashboard-card filters-bar">
    @using (Html.BeginForm("Index", "MedecinsAdresses", null, FormMethod.Get, null, null))
    {
        <div class="row">
            <input type="hidden" name="medecinId" value="@cmdpsfMedecinId" />
            <div class="col-md-8">
                <input type="text" name="search" value="@Context.Request.Query["search"].ToString()" class="form-control" placeholder="Recherche..." />
            </div>
            <div class="col-md-4 text-right">
                <button type="submit" class="btn btn-default"><i class="fa-solid fa-magnifying-glass"></i> Rechercher</button>
                @if (User.IsInRole("Admin") || User.IsInRole("SuperUtilisateur"))
                {
                    <a class="btn btn-primary" asp-action="Create" asp-route-medecinId="@cmdpsfMedecinId">Nouveau</a>
                }
            </div>
        </div>
    }
</div>

<div class="dashboard-card">
    <table class="table table-bordered table-striped table-hover registre-table js-datatable-fr">
        <thead>
            <tr>
                <th>Médecin</th>
                <th>Adresse</th>
                <th>Ville</th>
                <th>Province</th>
                <th>Code postal</th>
                <th>Principale</th>
                <th class="nowrap" style="width:140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MedecinLibelle</td>
                <td>@item.AdresseLigne1</td>
                <td>@item.Ville</td>
                <td>@item.Province</td>
                <td>@item.CodePostal</td>
                <td>@(item.EstPrincipale ? "Oui" : "Non")</td>
                <td class="table-actions nowrap">
                    <a href="@Url.Action("Details", new { id = item.MedecinAdresseId, medecinId = cmdpsfMedecinId })" class="btn btn-info btn-sm btn-icon-only" title="Détails"><i class="fa-solid fa-circle-info"></i></a>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperUtilisateur"))
                    {
                        <a href="@Url.Action("Edit", new { id = item.MedecinAdresseId, medecinId = cmdpsfMedecinId })" class="btn btn-warning btn-sm btn-icon-only" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></a>
                        <a href="@Url.Action("Delete", new { id = item.MedecinAdresseId, medecinId = cmdpsfMedecinId })" class="btn btn-danger btn-sm btn-icon-only" title="Supprimer"><i class="fa-solid fa-trash"></i></a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>