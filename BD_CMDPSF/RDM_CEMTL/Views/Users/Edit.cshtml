@model Solution.ViewModels.Administration.AspNetIdentityUserEditViewModel
@{
    ViewData["Title"] = "Modifier les rôles RDM";
}
<div class="page-header">
    <h2><i class="fa fa-user-shield"></i> Modifier les rôles RDM</h2>
    <p class="text-muted">Compte Windows : <strong>@Model.UserName</strong></p>
</div>
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="UserName" type="hidden" />
    <input asp-for="Email" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="alert alert-info">Cette modification concerne uniquement <code>AspNetUserRoles</code>. Active Directory n'est pas modifié.</div>
    <div class="panel panel-primary">
        <div class="panel-heading"><strong>Rôles RDM</strong></div>
        <div class="panel-body">
        @foreach (var role in Model.RolesDisponibles)
        {
            <label style="display:block;font-weight:normal">
                @if (role.Selected)
                {
                    <input type="checkbox" name="RolesSelectionnes" value="@role.Value" checked="checked" />
                }
                else
                {
                    <input type="checkbox" name="RolesSelectionnes" value="@role.Value" />
                }
                @role.Text
            </label>
        }
        <span asp-validation-for="RolesSelectionnes" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Enregistrer</button>
    <a asp-action="Index" class="btn btn-default">Annuler</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
