@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var appTitle = "Registre des médecins CEMTL";
    var currentController = ViewContext.RouteData.Values["controller"] != null
        ? ViewContext.RouteData.Values["controller"].ToString()
        : string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"] != null
        ? ViewContext.RouteData.Values["action"].ToString()
        : string.Empty;

    Func<string, string> isActive = ctrl =>
        string.Equals(currentController, ctrl, System.StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    Func<string, string, string> isActionActive = (ctrl, action) =>
        string.Equals(currentController, ctrl, System.StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, System.StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    var canSeeAdministration =
        (User?.Identity?.IsAuthenticated == true) &&
        (User.IsInRole("Admin") || User.IsInRole("SuperUtilisateur"));

    var afficherExportAdmin =
        User.IsInRole("Admin") &&
        string.Equals(currentAction, "Index", System.StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(currentController, "Home", System.StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(currentController, "Cmdpsf", System.StringComparison.OrdinalIgnoreCase); // CMDPSF a son propre export SQL complet

    var isHomeOpen =
        string.Equals(currentController, "Home", System.StringComparison.OrdinalIgnoreCase);

    var isRegistreOpen =
        string.Equals(currentController, "Cmdpsf", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "Medecins", System.StringComparison.OrdinalIgnoreCase) ||
        (string.Equals(currentController, "Departements", System.StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentAction, "Organisation", System.StringComparison.OrdinalIgnoreCase)) ||
        string.Equals(currentController, "AffectationsOrganisationnelles", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "NominationsAdministratives", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "EntentesFDC", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "FitTests", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "MedecinPrivileges", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "PrivilegeReferences", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "Nominations", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "CotisationsAnnuelles", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "MedecinAffectationsCliniques", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "DocumentsMedecin", System.StringComparison.OrdinalIgnoreCase);

    var isReferentielsOpen =
        string.Equals(currentController, "Installations", System.StringComparison.OrdinalIgnoreCase) ||
        (string.Equals(currentController, "Departements", System.StringComparison.OrdinalIgnoreCase) &&
         !string.Equals(currentAction, "Organisation", System.StringComparison.OrdinalIgnoreCase)) ||
        string.Equals(currentController, "Services", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "MedecinCoordonnees", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "TitresMedecin", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "TypesCourriel", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "TypesPermis", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "StatutsMedecin", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "CategoriesPratique", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "Genres", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "CodesCotisation", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "TypesPaiement", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "TypesInstanceDecision", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "InstancesDecision", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "JournalImports", System.StringComparison.OrdinalIgnoreCase);

    var isAdministrationOpen =
        string.Equals(currentController, "AuditLogs", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "Users", System.StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="fr-CA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - @appTitle</title>

    <!-- Styles de base -->
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/fontawesome-free-6.7.2-web/css/all.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/dataTables.bootstrap.min.css")" />
    <link rel="stylesheet" href="~/Content/registre-medecins.css" />

    <!-- Uniquement le décalage des sous-menus -->
    <style>
        /* Décalage global des sous-menus */
        .sidebar-nav {
            padding-left: 35px !important;
            margin-top: 4px;
        }

            /* Liens des sous-menus : un peu plus petits */
            .sidebar-nav > li > a {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 8px 12px 8px 16px !important;
                border-radius: 8px;
                font-size: 12.5px;
                line-height: 1.2;
            }

                /* Icônes des sous-menus */
                .sidebar-nav > li > a .nav-item-icon {
                    width: 16px;
                    text-align: center;
                    margin-right: 3px;
                    margin-left: 0 !important;
                    font-size: 12px;
                }

        /* Correction de la pagination DataTables (évite les conflits de clic) */
        .dataTables_wrapper .dataTables_paginate .paginate_button,
        .dataTables_wrapper .pagination > li > a,
        .dataTables_wrapper .pagination > li > span {
            cursor: pointer !important;
            pointer-events: auto !important;
        }

        .user-panel {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            flex: 0 0 auto;
            font-size: 30px;
        }

        .user-meta-inline {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .user-role {
            margin: 0;
            display: flex;
            align-items: center;
        }

        .logout-link {
            margin: 0;
            display: flex;
            align-items: center;
        }

            .logout-link .btn {
                margin: 0;
                padding: 0;
                line-height: 1.2;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="app-shell" id="appShell">
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-topbar">
                <div class="brand-block">
                    <div class="brand-icon">
                        <i class="fa-solid fa-user-doctor"></i>
                    </div>
                    <div class="brand-copy">
                        <div class="brand-title">Registre CMDPSF</div>
                        <div class="brand-subtitle">Comité des médecins, dentistes,</div>
                        <div class="brand-subtitle">pharmaciens et sages-femmes</div>
                    </div>
                </div>

                <button type="button"
                        class="sidebar-toggle"
                        id="sidebarToggle"
                        title="Réduire le menu"
                        aria-label="Réduire le menu">
                    <i class="fa-solid fa-angles-left"></i>
                </button>
            </div>

            @if ((User?.Identity?.IsAuthenticated == true))
            {
                <div class="user-panel">
                    <div class="user-avatar">
                        <i class="fa-regular fa-circle-user"></i>
                    </div>

                    <div class="user-meta user-meta-inline">
                        <div class="user-role">
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="label label-danger">Admin</span>
                            }
                            else if (User.IsInRole("SuperUtilisateur"))
                            {
                                <span class="label label-warning">SuperUtilisateur</span>
                            }
                            else
                            {
                                <span class="label label-default">Utilisateur</span>
                            }
                        </div>

                    </div>
                </div>
            }

            <nav class="menu-groups">
                <!-- Accueil -->
                <div class="nav-group menu-home @(isHomeOpen ? "is-open" : "")">
                    <button type="button"
                            class="nav-group-toggle"
                            aria-expanded="@(isHomeOpen ? "true" : "false")">
                        <span>
                            <i class="fa-solid fa-house nav-group-icon"></i>
                            <span class="nav-text">Accueil</span>
                        </span>
                        <i class="fa-solid fa-chevron-down nav-chevron"></i>
                    </button>
                    <ul class="sidebar-nav">
                        <li class="@isActive("Home")">
                            <a href="@Url.Action("Index", "Home")">
                                <i class="fa-solid fa-chart-line nav-item-icon"></i>
                                <span class="nav-text">Tableau de bord</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Registre -->
                <div class="nav-group menu-registre @(isRegistreOpen ? "is-open" : "")">
                    <button type="button"
                            class="nav-group-toggle"
                            aria-expanded="@(isRegistreOpen ? "true" : "false")">
                        <span>
                            <i class="fa-solid fa-address-card nav-group-icon"></i>
                            <span class="nav-text">Registre</span>
                        </span>
                        <i class="fa-solid fa-chevron-down nav-chevron"></i>
                    </button>
                    <ul class="sidebar-nav">
                        <li class="@isActive("Cmdpsf")">
                            <a href="@Url.Action("Index", "Cmdpsf")">
                                <i class="fa-solid fa-users nav-item-icon"></i>
                                <span class="nav-text">Registre CMDPSF</span>
                            </a>
                        </li>
                        <li class="@isActionActive("Departements", "Organisation")">
                            <a href="@Url.Action("Organisation", "Departements")">
                                <i class="fa-solid fa-table-list nav-item-icon"></i>
                                <span class="nav-text">Organisation médicale</span>
                            </a>
                        </li>
                        <li class="@isActive("AffectationsOrganisationnelles")">
                            <a href="@Url.Action("Index", "AffectationsOrganisationnelles")">
                                <i class="fa-solid fa-user-tag nav-item-icon"></i>
                                <span class="nav-text">Affectations organisationnelles</span>
                            </a>
                        </li>
                        <li class="@isActive("MedecinAffectationsCliniques")">
                            <a href="@Url.Action("Index", "MedecinAffectationsCliniques")">
                                <i class="fa-solid fa-sitemap nav-item-icon"></i>
                                <span class="nav-text">Affectations cliniques</span>
                            </a>
                        </li>
                        <li class="@isActive("NominationsAdministratives")">
                            <a href="@Url.Action("Index", "NominationsAdministratives")">
                                <i class="fa-solid fa-briefcase nav-item-icon"></i>
                                <span class="nav-text">Nominations</span>
                            </a>
                        </li>
                        <li class="@isActive("EntentesFDC")">
                            <a href="@Url.Action("Index", "EntentesFDC")">
                                <i class="fa-solid fa-file-signature nav-item-icon"></i>
                                <span class="nav-text">Ententes FDC</span>
                            </a>
                        </li>
                        <li class="@isActive("FitTests")">
                            <a href="@Url.Action("Index", "FitTests")">
                                <i class="fa-solid fa-shield-virus nav-item-icon"></i>
                                <span class="nav-text">Fit tests</span>
                            </a>
                        </li>
                        <li class="@isActive("DocumentsMedecin")">
                            <a href="@Url.Action("Index", "DocumentsMedecin")">
                                <i class="fa-solid fa-file-shield nav-item-icon"></i>
                                <span class="nav-text">Documents médecins</span>
                            </a>
                        </li>

                        <li class="@isActive("MedecinPrivileges")">
                            <a href="@Url.Action("Index", "MedecinPrivileges")">
                                <i class="fa-solid fa-gavel nav-item-icon"></i>
                                <span class="nav-text">Privilèges</span>
                            </a>
                        </li>




                        <li class="@isActive("CotisationsAnnuelles")">
                            <a href="@Url.Action("Index", "CotisationsAnnuelles")">
                                <i class="fa-solid fa-receipt nav-item-icon"></i>
                                <span class="nav-text">Cotisations</span>
                            </a>
                        </li>




                    </ul>
                </div>

                <!-- Référentiels -->
                <div class="nav-group compact-group menu-referentiels @(isReferentielsOpen ? "is-open" : "")">
                    <button type="button"
                            class="nav-group-toggle"
                            aria-expanded="@(isReferentielsOpen ? "true" : "false")">
                        <span>
                            <i class="fa-solid fa-layer-group nav-group-icon"></i>
                            <span class="nav-text">Référentiels</span>
                        </span>
                        <i class="fa-solid fa-chevron-down nav-chevron"></i>
                    </button>
                    <ul class="sidebar-nav compact">
                        <li class="@isActive("Installations")"><a href="@Url.Action("Index", "Installations")"><i class="fa-solid fa-hospital nav-item-icon"></i> Installations</a></li>
                        <li class="@isActionActive("Departements", "Index")"><a href="@Url.Action("Index", "Departements")"><i class="fa-solid fa-sitemap nav-item-icon"></i> Départements</a></li>
                        <li class="@isActive("Services")"><a href="@Url.Action("Index", "Services")"><i class="fa-solid fa-stethoscope nav-item-icon"></i> Services</a></li>
                        <li class="@isActive("MedecinCoordonnees")"><a href="@Url.Action("Index", "MedecinCoordonnees")"><i class="fa-solid fa-address-book nav-item-icon"></i> Coordonnées des médecins</a></li>
                        <li class="@isActive("TitresMedecin")"><a href="@Url.Action("Index", "TitresMedecin")"><i class="fa-solid fa-tag nav-item-icon"></i> Titres</a></li>
                        <li class="@isActive("TypesCourriel")"><a href="@Url.Action("Index", "TypesCourriel")"><i class="fa-solid fa-envelope nav-item-icon"></i> Types de courriel</a></li>
                        <li class="@isActive("TypesPermis")"><a href="@Url.Action("Index", "TypesPermis")"><i class="fa-solid fa-id-badge nav-item-icon"></i> Permis médecin</a></li>
                        <li class="@isActive("StatutsMedecin")"><a href="@Url.Action("Index", "StatutsMedecin")"><i class="fa-solid fa-signal nav-item-icon"></i> Statuts médecin</a></li>
                        <li class="@isActive("CategoriesPratique")"><a href="@Url.Action("Index", "CategoriesPratique")"><i class="fa-solid fa-stethoscope nav-item-icon"></i> Catégories</a></li>
                        <li class="@isActive("Genres")"><a href="@Url.Action("Index", "Genres")"><i class="fa-solid fa-venus-mars nav-item-icon"></i> Genres</a></li>
                        <li class="@isActive("CodesCotisation")"><a href="@Url.Action("Index", "CodesCotisation")"><i class="fa-solid fa-barcode nav-item-icon"></i> Cotisations</a></li>
                        <li class="@isActive("TypesPaiement")"><a href="@Url.Action("Index", "TypesPaiement")"><i class="fa-solid fa-credit-card nav-item-icon"></i> Paiements</a></li>
                        @*<li class="@isActive("TypesInstanceDecision")"><a href="@Url.Action("Index", "TypesInstanceDecision")"><i class="fa-solid fa-sliders nav-item-icon"></i> Types décision</a></li>
                    <li class="@isActive("InstancesDecision")"><a href="@Url.Action("Index", "InstancesDecision")"><i class="fa-solid fa-list-check nav-item-icon"></i> Instances décision</a></li>*@
                        <li class="@isActive("PrivilegeReferences")"><a href="@Url.Action("Index", "PrivilegeReferences")"><i class="fa-solid fa-scale-balanced nav-item-icon"></i><span class="nav-text">Privilèges</span></a></li>
                        <li class="@isActive("Nominations")"><a href="@Url.Action("Index", "Nominations")"><i class="fa-solid fa-receipt nav-item-icon"></i><span class="nav-text">Nominations</span></a></li>
                        @*<li class="@isActive("JournalImports")"><a href="@Url.Action("Index", "JournalImports")"><i class="fa-solid fa-file-import nav-item-icon"></i> Journal d'import</a></li>*@
                    </ul>
                </div>

                @if (canSeeAdministration)
                {
                    <div class="nav-group menu-administration @(isAdministrationOpen ? "is-open" : "")">
                        <button type="button"
                                class="nav-group-toggle"
                                aria-expanded="@(isAdministrationOpen ? "true" : "false")">
                            <span>
                                <i class="fa-solid fa-user-shield nav-group-icon"></i>
                                <span class="nav-text">Administration</span>
                            </span>
                            <i class="fa-solid fa-chevron-down nav-chevron"></i>
                        </button>
                        <ul class="sidebar-nav">
<li class="@isActive("AuditLogs")"><a href="@Url.Action("Index", "AuditLogs")"><i class="fa-solid fa-clock-rotate-left nav-item-icon"></i> Journal d'audit</a></li>
@if (User.IsInRole("Admin"))
{
    <li class="@isActive("Users")"><a href="@Url.Action("Index", "Users")"><i class="fa-solid fa-users-gear nav-item-icon"></i> Gestion des utilisateurs</a></li>
}
</ul>
                    </div>
                }
            </nav>
        </aside>

        <main class="main-content">
            <div class="topbar">
                <div>
                    <h1>@(ViewBag.Title ?? appTitle)</h1>
                    <p class="topbar-subtitle">
                        Répertoire des membres du CMDPSF
                    </p>
                </div>

                <div class="topbar-actions">
                    <button type="button"
                            class="sidebar-toggle mobile-toggle"
                            id="sidebarMobileToggle"
                            title="Ouvrir ou fermer le menu"
                            aria-label="Ouvrir ou fermer le menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    @if ((User?.Identity?.IsAuthenticated == true))
                    {
                        <span class="text-muted topbar-user">
                            <i class="fa-regular fa-circle-user"></i> @User.Identity.Name <span class="label label-default">@(string.Equals(Configuration["Authentication:UseActiveDirectory"], "true", System.StringComparison.OrdinalIgnoreCase) ? "AD" : "Admin local")</span>
                        </span>

                        @if (string.Equals(Configuration["Authentication:UseActiveDirectory"], "true", System.StringComparison.OrdinalIgnoreCase))
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline; margin-left:10px;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-default btn-sm" title="Fermer la session RDM">
                                    <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                                </button>
                            </form>
                        }
                    }
                </div>
            </div>

            @if (afficherExportAdmin)
            {
                <div id="adminExportToolbar"
                     class="admin-export-toolbar"
                     data-export-url="@Url.Action("Creer", "AdminExports")"
                     data-export-title="@(ViewBag.Title ?? appTitle)"
                     aria-label="Exportation des données filtrées">
                    @Html.AntiForgeryToken()
                    <span class="admin-export-label">
                        <i class="fa-solid fa-download"></i> Exporter
                    </span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Formats d'exportation">
                        <button type="button" class="btn btn-danger" data-export-format="pdf" title="Exporter les données filtrées en PDF">
                            <i class="fa-solid fa-file-pdf"></i> PDF
                        </button>
                        <button type="button" class="btn btn-primary" data-export-format="word" title="Exporter les données filtrées dans Word">
                            <i class="fa-solid fa-file-word"></i> Word
                        </button>
                        <button type="button" class="btn btn-success" data-export-format="excel" title="Exporter les données filtrées dans Excel">
                            <i class="fa-solid fa-file-excel"></i> Excel
                        </button>
                    </div>
                    <span class="admin-export-status text-muted" role="status" aria-live="polite"></span>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="@Url.Content("~/Scripts/jquery-3.7.1.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Scripts/dataTables.bootstrap.min.js")"></script>
    @if (afficherExportAdmin)
    {
        <script src="@Url.Content("~/Scripts/registre-admin-export.js")"></script>
    }

    <script>
        // Valeurs par défaut communes à tous les tableaux. Les écrans peuvent
        // encore préciser un libellé plus contextuel (p. ex. « Aucun médecin »).
        if ($.fn.dataTable) {
            $.extend(true, $.fn.dataTable.defaults, {
                language: {
                    decimal: ",",
                    thousands: " ",
                    emptyTable: "Aucune donnée disponible",
                    info: "Affichage de _START_ à _END_ sur _TOTAL_ éléments",
                    infoEmpty: "Aucun élément à afficher",
                    infoFiltered: "(filtré parmi _MAX_ éléments)",
                    lengthMenu: "Afficher _MENU_ éléments",
                    loadingRecords: "Chargement en cours…",
                    processing: "Traitement en cours…",
                    search: "Rechercher :",
                    zeroRecords: "Aucun résultat correspondant",
                    paginate: {
                        first: "Premier",
                        last: "Dernier",
                        next: "Suivant",
                        previous: "Précédent"
                    },
                    aria: {
                        sortAscending: ": activer pour trier la colonne en ordre croissant",
                        sortDescending: ": activer pour trier la colonne en ordre décroissant"
                    }
                }
            });
        }
    </script>

    <script>
        (function () {
            var body = document.body;
            var toggle = document.getElementById('sidebarToggle');
            var mobileToggle = document.getElementById('sidebarMobileToggle');
            var storageKey = 'registre-cemtl-sidebar-collapsed';

            function setCollapsed(collapsed) {
                if (collapsed) {
                    body.classList.add('sidebar-collapsed');
                    localStorage.setItem(storageKey, '1');
                } else {
                    body.classList.remove('sidebar-collapsed');
                    localStorage.setItem(storageKey, '0');
                }
            }

            if (localStorage.getItem(storageKey) === '1') {
                body.classList.add('sidebar-collapsed');
            }

            if (toggle) {
                toggle.addEventListener('click', function () {
                    setCollapsed(!body.classList.contains('sidebar-collapsed'));
                });
            }

            if (mobileToggle) {
                mobileToggle.addEventListener('click', function () {
                    body.classList.toggle('sidebar-open');
                });
            }

            Array.prototype.forEach.call(document.querySelectorAll('.nav-group-toggle'), function (button) {
                button.addEventListener('click', function () {
                    if (body.classList.contains('sidebar-collapsed')) {
                        setCollapsed(false);
                    }

                    var clickedGroup = button.parentElement;
                    var isAlreadyOpen = clickedGroup.classList.contains('is-open');

                    Array.prototype.forEach.call(document.querySelectorAll('.nav-group'), function (group) {
                        group.classList.remove('is-open');
                        var groupButton = group.querySelector('.nav-group-toggle');
                        if (groupButton) groupButton.setAttribute('aria-expanded', 'false');
                    });

                    if (!isAlreadyOpen) {
                        clickedGroup.classList.add('is-open');
                        button.setAttribute('aria-expanded', 'true');
                    }
                });
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
