@model IEnumerable<Solution.ViewModels.MedecinAffectationsCliniques.MedecinAffectationCliniqueListViewModel>
@{
    int cmdpsfReturnId;
    bool aFicheCmdpsf = int.TryParse(Context.Request.Query["medecinId"].ToString(), out cmdpsfReturnId) && cmdpsfReturnId > 0;
}
@if (aFicheCmdpsf) {
    <div class="dashboard-card"><a class="btn btn-default" asp-controller="Cmdpsf" asp-action="Details" asp-route-id="@cmdpsfReturnId"><i class="fa-solid fa-arrow-left"></i> Retour à la fiche CMDPSF</a></div>
}

@{
    ViewBag.Title = "Affectations cliniques";
    var canManage = ViewBag.CanManage != null && (bool)ViewBag.CanManage;
}
<div class="page-header-custom">
    <div class="row">
        <div class="col-md-8">
            <h2>Affectations cliniques</h2>
            <p class="text-muted">Appartenance des médecins aux départements et services, distincte des privilèges et des fonctions de chef.</p>
        </div>
        <div class="col-md-4 text-right" style="margin-top:25px;">
            @if (canManage)
            {
                <a href="@Url.Action("Create")" class="btn btn-success"><i class="fa-solid fa-plus"></i> Nouvelle affectation</a>
            }
        </div>
    </div>
</div>
<div class="dashboard-card">
    @using (Html.BeginForm("Index", "MedecinAffectationsCliniques", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom:15px;" }))
    {
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="min-width:280px;" placeholder="Médecin, service, installation..." />
        @Html.DropDownList("departementId", (SelectList)ViewBag.DepartementId, "-- Tous les départements --", new { @class = "form-control" })
        <label class="checkbox-inline"><input type="checkbox" name="actifsSeulement" value="true" @(ViewBag.ActifsSeulement ? "checked" : "") /> Actifs seulement</label>
        <button class="btn btn-primary" type="submit"><i class="fa-solid fa-filter"></i> Filtrer</button>
        <a class="btn btn-default" href="@Url.Action("Index")">Réinitialiser</a>
    }
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr><th>Médecin</th><th>Département</th><th>Service</th><th>Installation</th><th>Type</th><th>Principal</th><th>Période</th><th>État</th><th style="width:140px;">Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a href="@Url.Action("Index","Medecins",new { openMedecin=item.MedecinId, tab="organisation"})">@item.Medecin</a></td>
                    <td>@item.Departement</td>
                    <td>@item.Service</td>
                    <td>@item.Installation</td>
                    <td>@item.TypeAffectation</td>
                    <td>@(item.EstPrincipale ? "Oui" : "")</td>
                    <td>@item.DateDebut?.ToString("yyyy-MM-dd") @if(item.DateFin.HasValue){<text> → @item.DateFin.Value.ToString("yyyy-MM-dd")</text>}</td>
                    <td>@(item.EstActive ? "Active" : "Terminée")</td>
                    <td class="table-actions nowrap">
                        <a href="@Url.Action("Details",new { id=item.MedecinAffectationCliniqueId})" class="btn btn-info btn-sm btn-icon-only" title="Détails"><i class="fa-solid fa-circle-info"></i></a>
                        @if (canManage)
                        {
                            <a href="@Url.Action("Edit",new { id=item.MedecinAffectationCliniqueId})" class="btn btn-warning btn-sm btn-icon-only" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a href="@Url.Action("Delete",new { id=item.MedecinAffectationCliniqueId})" class="btn btn-danger btn-sm btn-icon-only" title="Terminer"><i class="fa-solid fa-calendar-xmark"></i></a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
