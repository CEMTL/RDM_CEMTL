@model Solution.ViewModels.AffectationsOrganisationnelles.AffectationOrganisationnelleFormViewModel

@Html.HiddenFor(m => m.AffectationOrganisationnelleId)

<div class="dashboard-card">
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @if (!string.IsNullOrWhiteSpace(Model.SourceDonnees))
    {
        <div class="alert alert-info">
            Source : <strong>@Model.SourceDonnees</strong>
            @if (Model.SourceLigne.HasValue) { <span> — ligne @Model.SourceLigne</span> }
            @if (!string.IsNullOrWhiteSpace(Model.CourrielSource)) { <span> — courriel source : @Model.CourrielSource</span> }
        </div>
    }

    <div class="row">
        <div class="col-md-6 form-group">
            @Html.LabelFor(m => m.RoleCode)
            @Html.DropDownListFor(m => m.RoleCode, Model.RoleOptions, "-- Sélectionner --", new { @class = "form-control", id = "RoleCode" })
            @Html.ValidationMessageFor(m => m.RoleCode, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 form-group" id="departementTarget">
            @Html.LabelFor(m => m.DepartementId)
            @Html.DropDownListFor(m => m.DepartementId, Model.DepartementOptions, "-- Sélectionner --", new { @class = "form-control", id = "DepartementId" })
            @Html.ValidationMessageFor(m => m.DepartementId, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 form-group" id="serviceTarget">
            @Html.LabelFor(m => m.ServiceId)
            @Html.DropDownListFor(m => m.ServiceId, Model.ServiceOptions, "-- Sélectionner --", new { @class = "form-control", id = "ServiceId" })
            @Html.ValidationMessageFor(m => m.ServiceId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 form-group">
            @Html.LabelFor(m => m.NomAffiche)
            @Html.TextBoxFor(m => m.NomAffiche, new { @class = "form-control", maxlength = 300 })
            @Html.ValidationMessageFor(m => m.NomAffiche, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 form-group">
            @Html.LabelFor(m => m.MedecinId)
            @Html.DropDownListFor(m => m.MedecinId, Model.MedecinOptions, "-- Aucun lien médecin --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.MedecinId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 form-group">
            @Html.LabelFor(m => m.Titre)
            @Html.TextBoxFor(m => m.Titre, new { @class = "form-control", maxlength = 300 })
            @Html.ValidationMessageFor(m => m.Titre, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 form-group">
            @Html.LabelFor(m => m.RegroupementSource)
            @Html.TextBoxFor(m => m.RegroupementSource, new { @class = "form-control", maxlength = 200, placeholder = "Ex. (Ophtalmologie-CUO)" })
            @Html.ValidationMessageFor(m => m.RegroupementSource, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 form-group">
            @Html.LabelFor(m => m.Courriel)
            @Html.TextBoxFor(m => m.Courriel, new { @class = "form-control", maxlength = 255, type = "email" })
            @Html.ValidationMessageFor(m => m.Courriel, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 form-group">
            @Html.LabelFor(m => m.Telephone)
            @Html.TextBoxFor(m => m.Telephone, new { @class = "form-control", maxlength = 50 })
            @Html.ValidationMessageFor(m => m.Telephone, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4 form-group">
            @Html.LabelFor(m => m.PosteTelephone)
            @Html.TextBoxFor(m => m.PosteTelephone, new { @class = "form-control", maxlength = 20 })
            @Html.ValidationMessageFor(m => m.PosteTelephone, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 form-group">
            @Html.LabelFor(m => m.InstallationId)
            @Html.DropDownListFor(m => m.InstallationId, Model.InstallationOptions, "-- Aucune installation liée --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.InstallationId, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 form-group">
            @Html.LabelFor(m => m.SiteNomSource)
            @Html.TextBoxFor(m => m.SiteNomSource, new { @class = "form-control", maxlength = 200 })
            @Html.ValidationMessageFor(m => m.SiteNomSource, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 form-group">
            @Html.LabelFor(m => m.DateDebut)
            @Html.TextBoxFor(m => m.DateDebut, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.DateDebut, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3 form-group">
            @Html.LabelFor(m => m.DateFin)
            @Html.TextBoxFor(m => m.DateFin, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.DateFin, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            <div class="checkbox"><label>@Html.CheckBoxFor(m => m.EstInterim) Intérim</label></div>
            <div class="checkbox"><label>@Html.CheckBoxFor(m => m.EstActive) Active</label></div>
            <div class="checkbox"><label>@Html.CheckBoxFor(m => m.EstAValider) À valider</label></div>
        </div>
    </div>
</div>

<script>
(function () {
    function updateTarget() {
        var role = document.getElementById('RoleCode');
        var dept = document.getElementById('departementTarget');
        var service = document.getElementById('serviceTarget');
        var deptSelect = document.getElementById('DepartementId');
        var serviceSelect = document.getElementById('ServiceId');
        var serviceRole = role && role.value === 'CHEF_SERVICE';
        dept.style.display = serviceRole ? 'none' : '';
        service.style.display = serviceRole ? '' : 'none';
        if (serviceRole && deptSelect) deptSelect.value = '';
        if (!serviceRole && serviceSelect) serviceSelect.value = '';
    }
    document.addEventListener('DOMContentLoaded', function () {
        var role = document.getElementById('RoleCode');
        if (role) role.addEventListener('change', updateTarget);
        updateTarget();
    });
})();
</script>
