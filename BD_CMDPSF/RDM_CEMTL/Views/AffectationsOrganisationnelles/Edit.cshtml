@model Solution.ViewModels.AffectationsOrganisationnelles.AffectationOrganisationnelleFormViewModel
@{
    ViewBag.Title = "Modifier l'affectation organisationnelle";
}
<div class="page-header-custom"><h2>Modifier l'affectation organisationnelle</h2></div>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_Form", Model)
    <div class="dashboard-card actions-card">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
        <a href="@Url.Action("Details", new { id = Model.AffectationOrganisationnelleId })" class="btn btn-default">Annuler</a>
    </div>
}
