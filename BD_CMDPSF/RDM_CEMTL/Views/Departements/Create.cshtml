@model Solution.ViewModels.Departements.DepartementFormViewModel
@{ ViewBag.Title = "Créer un département"; }
<div class="page-header-custom"><h2>Créer un département</h2></div>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.DepartementId)
    @await Html.PartialAsync("_Form", Model)
    <div class="dashboard-card"><button type="submit" class="btn btn-success">Enregistrer</button> @Html.ActionLink("Retour", "Index", null, new { @class = "btn btn-default" })</div>
}
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
