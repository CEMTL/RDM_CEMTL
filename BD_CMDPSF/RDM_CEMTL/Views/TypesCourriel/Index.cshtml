@model IEnumerable<Solution.ViewModels.TypesCourriel.TypeCourrielListViewModel>
@{
    ViewBag.Title = "Types de courriel";
    var canManage = User.IsInRole("Admin") || User.IsInRole("SuperUtilisateur");
}

<div class="page-header-custom">
    <h2>Types de courriel</h2>
</div>

@await Html.PartialAsync("~/Views/Shared/_Alerts.cshtml")

<div class="dashboard-card filters-bar">
    @using (Html.BeginForm("Index", "TypesCourriel", null, FormMethod.Get, null, null))
    {
        <div class="row">
            <div class="col-md-8">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Recherche par libellé..." />
            </div>
            <div class="col-md-4 text-right">
                <button type="submit" class="btn btn-default"><i class="fa-solid fa-magnifying-glass"></i> Rechercher</button>
                <a href="@Url.Action("Index")" class="btn btn-default"><i class="fa-solid fa-rotate-left"></i> Réinitialiser</a>
                @if (canManage)
                {
                    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Nouveau</a>
                }
            </div>
        </div>
    }
</div>

<div class="dashboard-card">
    <table class="table table-bordered table-striped table-hover registre-table">
        <thead>
            <tr>
                <th>Libellé</th>
                <th>Actif</th>
                <th>Courriels associés</th>
                <th class="nowrap" style="width:140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Libelle</td>
                    <td>@(item.EstActif ? "Oui" : "Non")</td>
                    <td>@item.NombreUtilisations</td>
                    <td class="table-actions nowrap">
                        <a href="@Url.Action("Details", new { id = item.TypeCourrielId })" class="btn btn-info btn-sm btn-icon-only" title="Détails"><i class="fa-solid fa-circle-info"></i></a>
                        @if (canManage)
                        {
                            <a href="@Url.Action("Edit", new { id = item.TypeCourrielId })" class="btn btn-warning btn-sm btn-icon-only" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.TypeCourrielId })" class="btn btn-danger btn-sm btn-icon-only" title="Supprimer"><i class="fa-solid fa-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
